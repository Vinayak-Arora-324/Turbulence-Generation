Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Plotting", " ", "the", " ", "distribution"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"distributionPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Histogram", "[", 
        RowBox[{"standardizedReturns", ",", 
         RowBox[{"{", "0.20", "}"}], ",", "\"\<PDF\>\"", ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Standardized return\>\"", ",", "\"\<Density\>\""}], 
           "}"}]}], ",", 
         RowBox[{"ChartStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.65", "]"}], ",", "Blue"}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"PDF", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", "]"}], ",", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "distributionPlot", "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<DistributionExport.png\>\"", ",", "distributionPlot"}], 
    "]"}]}]}]], "Input",
