Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Saving", " ", "Verification", " ", "Results"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"verificationSummary", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Distribution\>\"", "->", "distributionReport"}], ",", 
       RowBox[{"\"\<TailComparison\>\"", "->", "tailComparison"}], ",", 
       RowBox[{"\"\<Aggregation\>\"", "->", "aggregationStatistics"}], ",", 
       RowBox[{"\"\<ScalingExponents\>\"", "->", "scalingResults"}], ",", 
       RowBox[{"\"\<ZetaCurvature\>\"", "->", "zetaCurvature"}], ",", 
       RowBox[{"\"\<MaximumAbsoluteReturnACFFirst20Lags\>\"", "->", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Take", "[", 
           RowBox[{"returnACF", ",", "20"}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<MeanAbsoluteReturnACFFirst20Lags\>\"", "->", 
        RowBox[{"Mean", "[", 
         RowBox[{"Take", "[", 
          RowBox[{"absoluteReturnACF", ",", "20"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<MeanSquaredReturnACFFirst20Lags\>\"", "->", 
        RowBox[{"Mean", "[", 
         RowBox[{"Take", "[", 
          RowBox[{"squaredReturnACF", ",", "20"}], "]"}], "]"}]}]}], "|>"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "verificationDirectory", 
         ",", "\"\<statistical-verification.wxf\>\""}], "}"}], "]"}], ",", 
      "verificationSummary", ",", "\"\<WXF\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "verificationDirectory", 
         ",", "\"\<statistical-verification.pdf\>\""}], "}"}], "]"}], ",", 
      RowBox[{"GraphicsColumn", "[", 
       RowBox[{"{", 
        RowBox[{
        "distributionPlot", ",", "acfPlot", ",", "aggregationPlot", ",", 
         "structurePlot", ",", "zetaPlot"}], "}"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{"Dataset", "[", "verificationSummary", "]"}]}]}]], "Input",
