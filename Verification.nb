Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Tail", " ", "Behaviour", " ", "and", " ", "Distribution", " ", 
    "Verification"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "serialCorrelation", ",", "aggregateReturns", ",", "structureFunction"}],
      "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"returns", "=", 
     RowBox[{"market", "[", "\"\<Returns\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"logPrices", "=", 
     RowBox[{"market", "[", "\"\<LogPrices\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"standardizedReturns", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"returns", "-", 
        RowBox[{"Mean", "[", "returns", "]"}]}], ")"}], "/", 
      RowBox[{"StandardDeviation", "[", "returns", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "returns", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"skewness", "=", 
     RowBox[{"Skewness", "[", "returns", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"excessKurtosis", "=", 
     RowBox[{
      RowBox[{"Kurtosis", "[", "returns", "]"}], "-", "3"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"jarqueBera", "=", 
     RowBox[{
      RowBox[{"n", "/", "6"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"skewness", "^", "2"}], "+", 
        RowBox[{
         RowBox[{"excessKurtosis", "^", "2"}], "/", "4"}]}], ")"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"distributionReport", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Observations\>\"", "->", "n"}], ",", 
       RowBox[{"\"\<MeanReturn\>\"", "->", 
        RowBox[{"Mean", "[", "returns", "]"}]}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", "returns", "]"}], " ", 
         RowBox[{"Sqrt", "[", "252.", "]"}]}]}], ",", 
       RowBox[{"\"\<Skewness\>\"", "->", "skewness"}], ",", 
       RowBox[{"\"\<ExcessKurtosis\>\"", "->", "excessKurtosis"}], ",", 
       RowBox[{"\"\<JarqueBeraStatistic\>\"", "->", "jarqueBera"}], ",", 
       RowBox[{"\"\<JarqueBeraPValue\>\"", "->", 
        RowBox[{"SurvivalFunction", "[", 
         RowBox[{
          RowBox[{"ChiSquareDistribution", "[", "2", "]"}], ",", 
          "jarqueBera"}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
