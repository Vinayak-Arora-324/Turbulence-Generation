Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Return", " ", "and", " ", "volatility", " ", "autocorrelation"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"serialCorrelation", "[", 
      RowBox[{"data_List", ",", "maxLag_Integer"}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{";;", 
            RowBox[{
             RowBox[{"-", "lag"}], "-", "1"}]}], "]"}], "]"}], ",", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"lag", "+", "1"}], ";;"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"lag", ",", "1", ",", "maxLag"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxLag", "=", "200"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"returnACF", "=", 
     RowBox[{"serialCorrelation", "[", 
      RowBox[{"returns", ",", "maxLag"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"absoluteReturnACF", "=", 
     RowBox[{"serialCorrelation", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "returns", "]"}], ",", "maxLag"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"squaredReturnACF", "=", 
     RowBox[{"serialCorrelation", "[", 
      RowBox[{
       RowBox[{"returns", "^", "2"}], ",", "maxLag"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"confidenceBand", "=", 
     RowBox[{"1.96", "/", 
      RowBox[{"Sqrt", "[", "n", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"acfPlot", "=", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"returnACF", ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Lag\>\"", ",", "\"\<Return ACF\>\""}], "}"}]}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Dashed", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"1", ",", "confidenceBand"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"maxLag", ",", "confidenceBand"}], "}"}]}], "}"}], 
                "]"}], ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"1", ",", 
                    RowBox[{"-", "confidenceBand"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"maxLag", ",", 
                    RowBox[{"-", "confidenceBand"}]}], "}"}]}], "}"}], 
                "]"}]}], "}"}]}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"absoluteReturnACF", ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Lag\>\"", ",", "\"\<Absolute-return ACF\>\""}], 
              "}"}]}]}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"squaredReturnACF", ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<Lag\>\"", ",", "\"\<Squared-return ACF\>\""}], 
              "}"}]}]}], "]"}], "}"}]}], "}"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "acfPlot", "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<acfPlot.png\>\"", ",", "acfPlot"}], "]"}]}]}]], "Input",
