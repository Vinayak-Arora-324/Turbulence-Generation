      RowBox[{"{", 
       RowBox[{
       "verificationDirectory", ",", "\"\<generator-definition.wl\>\""}], 
       "}"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Mechanical", " ", "Verification"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"verificationDirectory", "=", 
     RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"verificationDirectory", "===", "$Canceled"}], ",", 
      RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"market", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"verificationDirectory", ",", "\"\<market-result.wxf\>\""}], 
         "}"}], "]"}], ",", "\"\<WXF\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"metadata", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"verificationDirectory", ",", "\"\<metadata.json\>\""}], 
         "}"}], "]"}], ",", "\"\<RawJSON\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"savedHashes", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"verificationDirectory", ",", "\"\<sha256.json\>\""}], "}"}],
         "]"}], ",", "\"\<RawJSON\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"parameters", "=", 
     RowBox[{"metadata", "[", "\"\<Parameters\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Verification", " ", "File", " ", "Integrity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hashResults", "=", 
     RowBox[{"Association", "@", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"savedPath", ",", "expectedHash"}], "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"localPath", ",", "actualHash"}], "}"}], ",", 
            RowBox[{
             RowBox[{"localPath", "=", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"verificationDirectory", ",", 
                 RowBox[{"FileNameTake", "[", "savedPath", "]"}]}], "}"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"actualHash", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"FileExistsQ", "[", "localPath", "]"}], ",", 
                RowBox[{"IntegerString", "[", 
                 RowBox[{
                  RowBox[{"FileHash", "[", 
                   RowBox[{"localPath", ",", "\"\<SHA256\>\""}], "]"}], ",", 
                  "16", ",", "64"}], "]"}], ",", 
                RowBox[{"Missing", "[", "\"\<FileNotFound\>\"", "]"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"FileNameTake", "[", "savedPath", "]"}], "->", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Exists\>\"", "->", 
                 RowBox[{"FileExistsQ", "[", "localPath", "]"}]}], ",", 
                RowBox[{"\"\<HashMatches\>\"", "->", 
                 RowBox[{"(", 
