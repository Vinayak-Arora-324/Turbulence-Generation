Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Temporal", " ", "Aggregation"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"aggregateReturns", "[", 
      RowBox[{"data_List", ",", "horizon_Integer"}], "]"}], ":=", 
     RowBox[{"Total", "/@", 
      RowBox[{"Partition", "[", 
       RowBox[{"data", ",", "horizon"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"horizons", "=", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "2", ",", "5", ",", "10", ",", "20", ",", "60", ",", "120"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aggregationStatistics", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "aggregated", "}"}], ",", 
         RowBox[{
          RowBox[{"aggregated", "=", 
           RowBox[{"aggregateReturns", "[", 
            RowBox[{"returns", ",", "horizon"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Horizon\>\"", "->", "horizon"}], ",", 
            RowBox[{"\"\<Observations\>\"", "->", 
             RowBox[{"Length", "[", "aggregated", "]"}]}], ",", 
            RowBox[{"\"\<Skewness\>\"", "->", 
             RowBox[{"Skewness", "[", "aggregated", "]"}]}], ",", 
            RowBox[{"\"\<ExcessKurtosis\>\"", "->", 
             RowBox[{
              RowBox[{"Kurtosis", "[", "aggregated", "]"}], "-", "3"}]}]}], 
           "|>"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"horizon", ",", "horizons"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "aggregationStatistics", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9959445838110027`*^9, 
  3.9959445985566797`*^9}},ExpressionUUID->"f4e25abb-c79c-433e-b1c7-\
538039ec104e"]
