Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Structure", " ", "functional", " ", "and", " ", "scaling", " ", 
    "exponents"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"structureFunction", "[", 
      RowBox[{"data_List", ",", 
       RowBox[{"order_", "?", "NumericQ"}], ",", "lagValues_List"}], "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lag", ",", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"lag", "+", "1"}], ";;"}], "]"}], "]"}], "-", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{";;", 
                RowBox[{
                 RowBox[{"-", "lag"}], "-", "1"}]}], "]"}], "]"}]}], "]"}], "^",
            "order"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"lag", ",", "lagValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lags", "=", 
     RowBox[{"DeleteDuplicates", "@", 
      RowBox[{"Round", "@", 
       RowBox[{"Exp", "@", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"Log", "[", "1", "]"}], ",", 
          RowBox[{"Log", "[", "256", "]"}], ",", "24"}], "]"}]}]}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orders", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.5", ",", "5.0", ",", "0.5"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"scalingResults", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"values", ",", "fit"}], "}"}], ",", 
         RowBox[{
          RowBox[{"values", "=", 
           RowBox[{"structureFunction", "[", 
            RowBox[{"logPrices", ",", "order", ",", "lags"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fit", "=", 
           RowBox[{"LinearModelFit", "[", 
            RowBox[{
             RowBox[{"Log", "[", "values", "]"}], ",", "scaleVariable", ",", 
             "scaleVariable"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Order\>\"", "->", "order"}], ",", 
            RowBox[{"\"\<Zeta\>\"", "->", 
             RowBox[{"Coefficient", "[", 
              RowBox[{
               RowBox[{"Normal", "[", "fit", "]"}], ",", "scaleVariable"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<RSquared\>\"", "->", 
             RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}]}], "|>"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"order", ",", "orders"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "scalingResults", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"selectedOrders", "=", 
     RowBox[{"{", 
      RowBox[{"1.", ",", "2.", ",", "3.", ",", "4.", ",", "5."}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"structurePlot", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"structureFunction", "[", 
          RowBox[{"logPrices", ",", "#", ",", "lags"}], "]"}], "&"}], "/@", 
        "selectedOrders"}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"\"\<q = \>\"", "<>", 
            RowBox[{"ToString", "[", "#", "]"}]}], "&"}], "/@", 
          "selectedOrders"}], ")"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Lag \[Tau]\>\"", 
          ",", "\"\<\\!\\(\\*SubscriptBox[\\(S\\), \\(q\\)]\\)(\[Tau])\>\""}],
          "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "structurePlot", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zetaData", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", "\"\<Order\>\"", "]"}], ",", 
         RowBox[{"#", "[", "\"\<Zeta\>\"", "]"}]}], "}"}], "&"}], "/@", 
      "scalingResults"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"zetaFit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"zetaData", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "q", ",", 
         RowBox[{"q", "^", "2"}]}], "}"}], ",", "q"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zetaCurvature", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Normal", "[", "zetaFit", "]"}], ",", "q", ",", "2"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"zetaPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{"zetaData", ",", 
         RowBox[{"PlotStyle", "->", "Blue"}], ",", 
         RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"Normal", "[", "zetaFit", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", 
           RowBox[{"Min", "[", "orders", "]"}], ",", 
           RowBox[{"Max", "[", "orders", "]"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"q", "/", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", 
           RowBox[{"Min", "[", "orders", "]"}], ",", 
           RowBox[{"Max", "[", "orders", "]"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Dashed"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Moment order q\>\"", ",", "\"\<\[Zeta](q)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "zetaPlot"}]}]], "Input",
 CellChangeTimes->{{3.9959447161080523`*^9, 3.995944733914959*^9}, {
  3.9959447755574636`*^9, 3.995944800097795*^9}},
