Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Verifying", " ", "internal", " ", "structure", " ", "and", " ", 
    "mathematical", " ", "identities"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"requiredKeys", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Returns\>\"", ",", "\"\<Prices\>\"", 
       ",", "\"\<LogPrices\>\"", ",", "\"\<Volatility\>\"", 
       ",", "\"\<Innovation\>\"", ",", "\"\<LogVolatility\>\"", 
       ",", "\"\<ScaleFields\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesKeys", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Returns\>\"", ",", "\"\<Prices\>\"", 
       ",", "\"\<LogPrices\>\"", ",", "\"\<Volatility\>\"", 
       ",", "\"\<Innovation\>\"", ",", "\"\<LogVolatility\>\""}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"returns", "=", 
     RowBox[{"market", "[", "\"\<Returns\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"prices", "=", 
     RowBox[{"market", "[", "\"\<Prices\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"logPrices", "=", 
     RowBox[{"market", "[", "\"\<LogPrices\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"volatility", "=", 
     RowBox[{"market", "[", "\"\<Volatility\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expectedLogPrices", "=", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"parameters", "[", "\"\<InitialPrice\>\"", "]"}], "]"}], "+", 
      RowBox[{"Accumulate", "[", "returns", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxLogPriceError", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"logPrices", "-", "expectedLogPrices"}], "]"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxPriceError", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"prices", "-", 
        RowBox[{"Exp", "[", "logPrices", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"verificationReport", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<RequiredKeysPresent\>\"", "->", 
        RowBox[{"ContainsAll", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "market", "]"}], ",", "requiredKeys"}], 
         "]"}]}], ",", 
       RowBox[{"\"\<SeriesLengthsAgree\>\"", "->", 
        RowBox[{"SameQ", "@@", 
         RowBox[{"(", 
          RowBox[{"Length", "/@", 
           RowBox[{"Lookup", "[", 
            RowBox[{"market", ",", "seriesKeys"}], "]"}]}], ")"}]}]}], ",", 
       RowBox[{"\"\<ExpectedLength\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Length", "[", "returns", "]"}], "===", 
          RowBox[{"parameters", "[", "\"\<Length\>\"", "]"}]}], ")"}]}], ",", 
       
       RowBox[{"\"\<ReturnsAreNumeric\>\"", "->", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"returns", ",", "NumericQ"}], "]"}]}], ",", 
       RowBox[{"\"\<PricesArePositive\>\"", "->", 
        RowBox[{"AllTrue", "[", 
         RowBox[{"prices", ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ",", 
       RowBox[{"\"\<VolatilityIsPositive\>\"", "->", 
        RowBox[{"AllTrue", "[", 
         RowBox[{"volatility", ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ",", 
       RowBox[{"\"\<LogPriceIdentityPasses\>\"", "->", 
        RowBox[{"maxLogPriceError", "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], ",", 
       RowBox[{"\"\<PriceIdentityPasses\>\"", "->", 
        RowBox[{"maxPriceError", "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], ",", 
       RowBox[{"\"\<MaximumLogPriceError\>\"", "->", "maxLogPriceError"}], ",", 
       RowBox[{"\"\<MaximumPriceError\>\"", "->", "maxPriceError"}], ",", 
       RowBox[{"\"\<RealizedAnnualizedVolatility\>\"", "->", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", "returns", "]"}], " ", 
         RowBox[{"Sqrt", "[", "252.", "]"}]}]}], ",", 
       RowBox[{"\"\<TotalLogReturn\>\"", "->", 
        RowBox[{"Total", "[", "returns", "]"}]}], ",", 
       RowBox[{"\"\<FinalPrice\>\"", "->", 
        RowBox[{"Last", "[", "prices", "]"}]}], ",", 
       RowBox[{"\"\<EndpointAppearsArtificiallyPinned\>\"", "->", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Total", "[", "returns", "]"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "verificationReport", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.99594386743143*^9, 
  3.995943948081582*^9}},ExpressionUUID->"cb38c805-0ca7-4e71-8979-\
0e82ffb11b5b"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Deterministic", " ", "Reproducubility"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Get", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "verificationDirectory", ",", "\"\<generator-definition.wl\>\""}], 
       "}"}], "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"regenerated", "=", 
     RowBox[{"generateMarket", "[", 
      RowBox[{
       RowBox[{"parameters", "[", "\"\<Length\>\"", "]"}], ",", 
       RowBox[{"parameters", "[", "\"\<Seed\>\"", "]"}], ",", 
       RowBox[{"parameters", "[", "\"\<Levels\>\"", "]"}], ",", 
       RowBox[{"parameters", "[", "\"\<Intermittency\>\"", "]"}], ",", 
       RowBox[{"parameters", "[", "\"\<Persistence\>\"", "]"}], ",", 
       RowBox[{"parameters", "[", "\"\<AnnualizedVolatility\>\"", "]"}], ",", 
       
       RowBox[{"parameters", "[", "\"\<InitialPrice\>\"", "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"reproducibilityReport", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReturnsExactlyReproduced\>\"", "->", 
        RowBox[{"SameQ", "[", 
         RowBox[{
          RowBox[{"market", "[", "\"\<Returns\>\"", "]"}], ",", 
          RowBox[{"regenerated", "[", "\"\<Returns\>\"", "]"}]}], "]"}]}], ",", 
       RowBox[{"\"\<VolatilityExactlyReproduced\>\"", "->", 
        RowBox[{"SameQ", "[", 
         RowBox[{
          RowBox[{"market", "[", "\"\<Volatility\>\"", "]"}], ",", 
          RowBox[{"regenerated", "[", "\"\<Volatility\>\"", "]"}]}], "]"}]}], 
       ",", 
       RowBox[{"\"\<PricesExactlyReproduced\>\"", "->", 
        RowBox[{"SameQ", "[", 
         RowBox[{
          RowBox[{"market", "[", "\"\<Prices\>\"", "]"}], ",", 
          RowBox[{"regenerated", "[", "\"\<Prices\>\"", "]"}]}], "]"}]}]}], 
      "|>"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", "reproducibilityReport", "]"}]}]}]], "Input",
