      RowBox[{"{", 
       RowBox[{"\"\<Time\>\"", ",", "\"\<Transfer flux\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Capacity-Limited Nonlinear Transfer\>\""}], ",", 
     
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
  ";"}], "\n", "interactingCascadeFluxPlot", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interactingCascadeDissipationPlot", "=", 
   RowBox[{"ListLinePlot", "[", 
