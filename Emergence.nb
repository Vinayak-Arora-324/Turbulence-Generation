 RowBox[{
  RowBox[{
   RowBox[{"exportTimestamp", "=", 
    RowBox[{"DateString", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Year\>\"", ",", "\"\<Month\>\"", ",", "\"\<Day\>\"", 
       ",", "\"\<-\>\"", ",", "\"\<Hour\>\"", ",", "\"\<Minute\>\"", 
       ",", "\"\<Second\>\""}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"currentGraphExportDirectory", "=", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"projectDirectory", ",", "\"\<exports\>\"", ",", 
       RowBox[{"\"\<endogenous-reservoirs-\>\"", "<>", "exportTimestamp"}]}], 
      "}"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CreateDirectory", "[", 
   RowBox[{"currentGraphExportDirectory", ",", 
    RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"currentCascadeGraphs", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<interacting-multiscale-reservoirs\>\"", "->", 
      "interactingCascadeStatePlot"}], ",", 
     RowBox[{"\"\<capacity-limited-nonlinear-transfer\>\"", "->", 
      "interactingCascadeFluxPlot"}], ",", 
     RowBox[{"\"\<forcing-versus-fine-scale-dissipation\>\"", "->", 
      "interactingCascadeDissipationPlot"}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"currentGraphPNGFiles", "=", 
   RowBox[{"Association", "@", 
    RowBox[{"KeyValueMap", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"graphName", ",", "graph"}], "}"}], ",", 
        RowBox[{"graphName", "->", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"currentGraphExportDirectory", ",", 
              RowBox[{"graphName", "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",",
            "graph", ",", 
           RowBox[{"ImageResolution", "->", "300"}]}], "]"}]}]}], "]"}], ",", 
      "currentCascadeGraphs"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"currentGraphPDFFiles", "=", 
