Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "AddCoarseStorageRelease", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "AddCoarseStorageRelease", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<OpenThreshold\>\"", "->", "2.0"}], ",", 
      RowBox[{"\"\<CloseThreshold\>\"", "->", "0.40"}], ",", 
      RowBox[{"\"\<GateResponse\>\"", "->", "0.30"}], ",", 
      RowBox[{"\"\<MaximumReleaseFraction\>\"", "->", "0.45"}], ",", 
      RowBox[{"\"\<NonlinearReference\>\"", "->", "2.0"}], ",", 
      RowBox[{"\"\<BackgroundDissipationRate\>\"", "->", "0.002"}]}], "}"}]}],
    ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AddCoarseStorageRelease", "[", 
    RowBox[{"forcingBase_Association", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "openThreshold", ",", "closeThreshold", ",", "gateResponse", ",", 
       "maximumReleaseFraction", ",", "nonlinearReference", ",", 
       "backgroundDissipationRate", ",", "coarseForcing", ",", "initialState",
        ",", "storageStep", ",", "stateHistory", ",", "coarseEnergy", ",", 
       "transferGate", ",", "gateLatch", ",", "releaseFlux", ",", 
       "backgroundDissipation"}], "}"}], ",", 
     RowBox[{
      RowBox[{"openThreshold", "=", 
       RowBox[{"N", "@", 
        RowBox[{"OptionValue", "[", "\"\<OpenThreshold\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"closeThreshold", "=", 
       RowBox[{"N", "@", 
        RowBox[{"OptionValue", "[", "\"\<CloseThreshold\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gateResponse", "=", 
       RowBox[{"N", "@", 
        RowBox[{"OptionValue", "[", "\"\<GateResponse\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maximumReleaseFraction", "=", 
       RowBox[{"N", "@", 
        RowBox[{
        "OptionValue", "[", "\"\<MaximumReleaseFraction\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nonlinearReference", "=", 
       RowBox[{"N", "@", 
        RowBox[{"OptionValue", "[", "\"\<NonlinearReference\>\"", "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"backgroundDissipationRate", "=", 
       RowBox[{"N", "@", 
        RowBox[{
        "OptionValue", "[", "\"\<BackgroundDissipationRate\>\"", "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"closeThreshold", "<", "0."}], "||", 
         RowBox[{"openThreshold", "<=", "closeThreshold"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidThresholds\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             "->", "\"\<OpenThreshold must be greater than CloseThreshold, \
and both must be non-negative.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gateResponse", "<=", "0."}], "||", 
         RowBox[{"gateResponse", ">", "1."}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidGateResponse\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             "->", "\"\<GateResponse must satisfy 0 < response <= 1.\>\""}], 
            "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maximumReleaseFraction", "<", "0."}], "||", 
         RowBox[{"backgroundDissipationRate", "<", "0."}], "||", 
         RowBox[{
          RowBox[{
          "maximumReleaseFraction", "+", "backgroundDissipationRate"}], ">", 
          "1."}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidActivityBudget\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             
             "->", "\"\<Maximum release plus background dissipation cannot \
exceed one.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nonlinearReference", "<=", "0."}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidNonlinearReference\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             "->", "\"\<NonlinearReference must be positive.\>\""}], "|>"}]}],
           "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"coarseForcing", "=", 
       RowBox[{"forcingBase", "[", "\"\<CoarseForcing\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"State", " ", 
        RowBox[{"vector", ":", 
         RowBox[{
         "1.", " ", "stored", " ", "coarse", " ", "energy", " ", "2.", " ", 
          "continuous", " ", "gate", " ", "position", " ", "3.", " ", 
          "hysteretic", " ", "gate", " ", "latch", " ", "4.", " ", "release", 
          " ", "flux", " ", "generated", " ", "during", " ", "the", " ", 
          "step", " ", "5.", " ", "background", " ", "dissipation", " ", 
          "during", " ", "the", " ", "step"}]}]}], "*)"}], 
      RowBox[{"initialState", "=", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0.", ",", "0.", ",", "0.", ",", "0."}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"storageStep", "[", 
        RowBox[{"state_List", ",", 
         RowBox[{"forcing_", "?", "NumericQ"}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "energy", ",", "gate", ",", "latch", ",", "nextLatch", ",", 
           "nextGate", ",", "nonlinearActivation", ",", "currentRelease", ",",
            "currentDissipation", ",", "nextEnergy"}], "}"}], ",", 
         RowBox[{
          RowBox[{"energy", "=", 
           RowBox[{"state", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"gate", "=", 
           RowBox[{"state", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"latch", "=", 
           RowBox[{"state", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Hysteresis", ":", 
            RowBox[{
            "open", " ", "at", " ", "the", " ", "upper", " ", "threshold", " ",
              "remain", " ", "open", " ", "between", " ", "thresholds", " ", 
             "close", " ", "at", " ", "the", " ", "lower", " ", 
             "threshold"}]}], "*)"}], 
          RowBox[{"nextLatch", "=", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"energy", ">=", "openThreshold"}], ",", "1.", ",", 
             RowBox[{"energy", "<=", "closeThreshold"}], ",", "0.", ",", 
             "True", ",", "latch"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "The", " ", "gate", " ", "approaches", " ", "its", " ", "target", " ", 
            RowBox[{"gradually", "."}]}], "*)"}], 
          RowBox[{"nextGate", "=", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"gate", "+", 
              RowBox[{"gateResponse", " ", 
               RowBox[{"(", 
                RowBox[{"nextLatch", "-", "gate"}], ")"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"0.", ",", "1."}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Low", " ", 
            RowBox[{"activity", ":", 
             RowBox[{
             "release", " ", "approximately", " ", "proportional", " ", "to", 
              " ", 
              RowBox[{"E", "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}], " ", "High", " ", 
              "activity"}], ":", 
             RowBox[{
             "release", " ", "remains", " ", "below", " ", 
              "MaximumReleaseFraction", " ", "E"}]}]}], "*)"}], 
          RowBox[{"nonlinearActivation", "=", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{"energy", "/", "nonlinearReference"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1.", "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"energy", "/", "nonlinearReference"}], "]"}]}], 
             ")"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentRelease", "=", 
           RowBox[{
           "maximumReleaseFraction", "*", "nextGate", "*", "energy", "*", 
            "nonlinearActivation"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentDissipation", "=", 
           RowBox[{"backgroundDissipationRate", " ", "energy"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"nextEnergy", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"0.", ",", 
             RowBox[{
             "energy", "+", "forcing", "-", "currentRelease", "-", 
              "currentDissipation"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "nextEnergy", ",", "nextGate", ",", "nextLatch", ",", 
            "currentRelease", ",", "currentDissipation"}], "}"}]}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"stateHistory", "=", 
       RowBox[{"Rest", "@", 
        RowBox[{"FoldList", "[", 
         RowBox[{"storageStep", ",", "initialState", ",", "coarseForcing"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"coarseEnergy", "=", 
       RowBox[{"stateHistory", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"transferGate", "=", 
       RowBox[{"stateHistory", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gateLatch", "=", 
       RowBox[{"stateHistory", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"releaseFlux", "=", 
       RowBox[{"stateHistory", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"backgroundDissipation", "=", 
       RowBox[{"stateHistory", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "5"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Join", "[", 
       RowBox[{"forcingBase", ",", 
        RowBox[{"<|", 
         RowBox[{
          
          RowBox[{"\"\<Stage\>\"", 
           "->", "\"\<HystereticCoarseStorageRelease\>\""}], ",", 
          RowBox[{"\"\<Version\>\"", "->", "\"\<1.1.0\>\""}], ",", 
          
          RowBox[{"\"\<ParentStage\>\"", 
           "->", "\"\<BoundedContinuousCoarseForcing\>\""}], ",", 
          RowBox[{"\"\<CoarseEnergy\>\"", "->", "coarseEnergy"}], ",", 
          RowBox[{"\"\<TransferGate\>\"", "->", "transferGate"}], ",", 
          RowBox[{"\"\<GateLatch\>\"", "->", "gateLatch"}], ",", 
          RowBox[{"\"\<CoarseReleaseFlux\>\"", "->", "releaseFlux"}], ",", 
          
          RowBox[{"\"\<CoarseDissipation\>\"", "->", 
           "backgroundDissipation"}], ",", 
          RowBox[{"(*", 
           RowBox[{"Stable", " ", "cascade", " ", "interface"}], "*)"}], 
          RowBox[{"\"\<ScaleStates\>\"", "->", 
           RowBox[{"List", "/@", "coarseEnergy"}]}], ",", 
          RowBox[{"\"\<TransferFluxes\>\"", "->", 
           RowBox[{"List", "/@", "releaseFlux"}]}], ",", 
          RowBox[{"\"\<DissipationFluxes\>\"", "->", 
           RowBox[{"List", "/@", "backgroundDissipation"}]}], ",", 
          RowBox[{"\"\<Parameters\>\"", "->", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"forcingBase", "[", "\"\<Parameters\>\"", "]"}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<OpenThreshold\>\"", "->", "openThreshold"}], ",", 
               
               RowBox[{"\"\<CloseThreshold\>\"", "->", "closeThreshold"}], ",", 
               RowBox[{"\"\<GateResponse\>\"", "->", "gateResponse"}], ",", 
               
               RowBox[{"\"\<MaximumReleaseFraction\>\"", "->", 
                "maximumReleaseFraction"}], ",", 
               
               RowBox[{"\"\<NonlinearReference\>\"", "->", 
                "nonlinearReference"}], ",", 
               
               RowBox[{"\"\<BackgroundDissipationRate\>\"", "->", 
                "backgroundDissipationRate"}], ",", 
               
               RowBox[{"\"\<PeakTimingRule\>\"", 
                "->", "\"\<None: release is activated by stored \
activity\>\""}]}], "|>"}]}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
