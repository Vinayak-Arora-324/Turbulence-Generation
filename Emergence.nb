Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Using", " ", "non", " ", "linear", " ", "multiscale", " ", "cascades", " ",
     "so", " ", "peark", " ", "formation", " ", "emerges", " ", "from", " ", 
    "it", " ", "rather", " ", "than", " ", "it", " ", "being", " ", 
    "additive", " ", "to", " ", "the", " ", "base"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$HistoryLength", "=", "0"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.995959868216626*^9, 
  3.995959902138636*^9}},ExpressionUUID->"fc1665b7-a4e6-4a80-a0f5-\
0afb0af9968e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "GenerateEndogenousForcingBase", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "GenerateEndogenousForcingBase", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<MeanForcing\>\"", "->", "0.03"}], ",", 
      RowBox[{"\"\<ForcingVariation\>\"", "->", "0.25"}], ",", 
      RowBox[{"\"\<RandomMethod\>\"", "->", "\"\<MersenneTwister\>\""}]}], 
     "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GenerateEndogenousForcingBase", "[", 
    RowBox[{"seed_Integer", ",", 
     RowBox[{"length_Integer", "?", "Positive"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "meanForcing", ",", "forcingVariation", ",", "randomMethod", ",", 
       "randomStreams", ",", "forcingInnovation", ",", "observationCarrier", ",",
        "coarseForcing", ",", "forcingLowerBound", ",", "forcingUpperBound"}],
       "}"}], ",", 
     RowBox[{
      RowBox[{"meanForcing", "=", 
       RowBox[{"N", "@", 
        RowBox[{"OptionValue", "[", "\"\<MeanForcing\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"forcingVariation", "=", 
       RowBox[{"N", "@", 
        RowBox[{"OptionValue", "[", "\"\<ForcingVariation\>\"", "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"randomMethod", "=", 
       RowBox[{"OptionValue", "[", "\"\<RandomMethod\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"meanForcing", "<=", "0."}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidMeanForcing\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             "->", "\"\<MeanForcing must be positive.\>\""}], "|>"}]}], "]"}],
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"forcingVariation", "<", "0."}], "||", 
         RowBox[{"forcingVariation", ">=", "1."}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidForcingVariation\>\"", ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<Message\>\"", 
             "->", "\"\<ForcingVariation must satisfy 0 <= variation < \
1.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Generate", " ", "two", " ", "deterministic", " ", "streams", " ", 
        "from", " ", "one", " ", 
        RowBox[{"seed", ":", 
         RowBox[{"stream", " ", "1"}], ":", 
         RowBox[{
         "coarse", " ", "forcing", " ", "fluctuations", " ", "stream", " ", 
          "2"}], ":", 
         RowBox[{
         "signed", " ", "observation", " ", "carrier", " ", "used", " ", 
          "later", " ", "They", " ", "are", " ", "generated", " ", "together",
           " ", "so", " ", "the", " ", "complete", " ", "model", " ", "needs",
           " ", "only", " ", "one", " ", "external", " ", 
          RowBox[{"seed", "."}]}]}]}], "*)"}], 
      RowBox[{"randomStreams", "=", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", 
          RowBox[{"seed", ",", 
           RowBox[{"Method", "->", "randomMethod"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0.", ",", "1."}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "length"}], "}"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"forcingInnovation", "=", 
       RowBox[{"randomStreams", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"observationCarrier", "=", 
       RowBox[{"randomStreams", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Bounded", " ", "continuous", " ", "activity", " ", 
           RowBox[{"injection", ".", "Since"}]}], "-", "1"}], "<", 
         RowBox[{"Tanh", "[", "z", "]"}], "<", "1"}], ":", 
        RowBox[{
         RowBox[{"F0", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "variation"}], ")"}]}], "<", "forcing", "<", 
         RowBox[{"F0", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "variation"}], ")"}]}]}]}], "*)"}], 
      RowBox[{"coarseForcing", "=", 
       RowBox[{"meanForcing", "*", 
        RowBox[{"(", 
         RowBox[{"1.", "+", 
          RowBox[{"forcingVariation", " ", 
           RowBox[{"Tanh", "[", "forcingInnovation", "]"}]}]}], ")"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"forcingLowerBound", "=", 
       RowBox[{"meanForcing", " ", 
        RowBox[{"(", 
         RowBox[{"1.", "-", "forcingVariation"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"forcingUpperBound", "=", 
       RowBox[{"meanForcing", " ", 
        RowBox[{"(", 
         RowBox[{"1.", "+", "forcingVariation"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Model\>\"", 
         "->", "\"\<EndogenousOneDimensionalTurbulence\>\""}], ",", 
        RowBox[{"\"\<Stage\>\"", 
         "->", "\"\<BoundedContinuousCoarseForcing\>\""}], ",", 
        RowBox[{"\"\<Version\>\"", "->", "\"\<1.0.0\>\""}], ",", 
        RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", 
        RowBox[{"\"\<Length\>\"", "->", "length"}], ",", 
        RowBox[{"\"\<ForcingInnovation\>\"", "->", "forcingInnovation"}], ",", 
        RowBox[{"\"\<ObservationCarrier\>\"", "->", "observationCarrier"}], ",", 
        RowBox[{"\"\<CoarseForcing\>\"", "->", "coarseForcing"}], ",", 
        RowBox[{"\"\<Parameters\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<MeanForcing\>\"", "->", "meanForcing"}], ",", 
           RowBox[{"\"\<ForcingVariation\>\"", "->", "forcingVariation"}], ",", 
           RowBox[{"\"\<ForcingLowerBound\>\"", "->", "forcingLowerBound"}], ",", 
           RowBox[{"\"\<ForcingUpperBound\>\"", "->", "forcingUpperBound"}], ",", 
           RowBox[{"\"\<RandomMethod\>\"", "->", "randomMethod"}], ",", 
           RowBox[{"\"\<ForcingMemory\>\"", "->", "\"\<None\>\""}], ",", 
           RowBox[{"\"\<ImposedPeakFrequency\>\"", "->", "\"\<None\>\""}], ",", 
           RowBox[{"\"\<ImposedPeakSeverity\>\"", "->", "\"\<None\>\""}]}], 
          "|>"}]}]}], "|>"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.995959926992256*^9, 3.995959926992309*^9}},
 CellLabel->
  "In[285]:=",ExpressionUUID->"2e5ba293-c025-4848-9649-5fe1062c8904"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"endogenousSeed", "=", "20260817"}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"endogenousLength", "=", "8192"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"endogenousMeanForcing", "=", "0.03"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"endogenousForcingVariation", "=", "0.25"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"endogenousForcingBase", "=", 
     RowBox[{"GenerateEndogenousForcingBase", "[", 
      RowBox[{"endogenousSeed", ",", "endogenousLength", ",", 
       RowBox[{"\"\<MeanForcing\>\"", "->", "endogenousMeanForcing"}], ",", 
       RowBox[{"\"\<ForcingVariation\>\"", "->", 
        "endogenousForcingVariation"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.995959936140895*^9, 3.995959936420371*^9}},
 CellLabel->
  "In[288]:=",ExpressionUUID->"efb8e724-1217-4013-b9ff-c1f9835f10f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"endogenousForcingPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"endogenousForcingBase", "[", "\"\<CoarseForcing\>\"", "]"}],
          ",", "1000"}], "]"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Injected activity\>\""}], "}"}]}], 
       ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Bounded Continuous Coarse-Scale Forcing\>\""}],
        ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "endogenousForcingPlot", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"forcingTransformationPlot", "=", 
     RowBox[{"GraphicsColumn", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
            "endogenousForcingBase", "[", "\"\<ForcingInnovation\>\"", "]"}], 
            ",", "500"}], "]"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Time\>\"", ",", "\"\<Gaussian innovation\>\""}], 
            "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", "\"\<Gaussian Forcing Innovation\>\""}], 
          ",", 
          RowBox[{"ImageSize", "->", "Large"}]}], "]"}], ",", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{
            "endogenousForcingBase", "[", "\"\<CoarseForcing\>\"", "]"}], ",",
             "500"}], "]"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Time\>\"", ",", "\"\<Bounded forcing\>\""}], "}"}]}],
           ",", 
          RowBox[{"PlotLabel", "->", "\"\<Bounded Activity Injection\>\""}], ",", 
          RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "}"}], "]"}]}], 
    ";"}], "\n", "forcingTransformationPlot", 
   "\[IndentingNewLine]"}]}]], "Input",
