 RowBox[{
  RowBox[{"interactingCascadeWindow", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interactingCascadeStatePlot", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"interactingCascadeCore", "[", "\"\<ScaleStates\>\"", "]"}], ",",
         "interactingCascadeWindow"}], "]"}], "]"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Scale 1: coarse\>\"", ",", "\"\<Scale 2\>\"", 
        ",", "\"\<Scale 3\>\"", ",", "\"\<Scale 4: fine\>\""}], "}"}]}], ",", 
     
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time\>\"", ",", "\"\<Stored activity\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Interacting Multiscale Reservoirs\>\""}],
      ",", 
     RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "interactingCascadeStatePlot", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"interactingCascadeFluxPlot", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{
