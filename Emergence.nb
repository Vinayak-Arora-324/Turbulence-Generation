        "interactingCascadeWindow"}], "]"}], "]"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Flux 1 -> 2\>\"", ",", "\"\<Flux 2 -> 3\>\"", 
        ",", "\"\<Flux 3 -> 4\>\""}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
