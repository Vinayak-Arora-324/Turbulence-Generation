Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "AddInteractingMultiscaleReservoirs", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AddInteractingMultiscaleReservoirs", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<OpenThresholds\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.80", ",", "0.45", ",", "0.12"}], "}"}]}], ",", 
       RowBox[{"\"\<CloseThresholds\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.45", ",", "0.10", ",", "0.025"}], "}"}]}], ",", 
       RowBox[{"\"\<GateResponses\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.22", ",", "0.35", ",", "0.55"}], "}"}]}], ",", 
       RowBox[{"\"\<MaximumTransferFractions\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.45", ",", "0.60", ",", "0.75"}], "}"}]}], ",", 
       RowBox[{"\"\<NonlinearReferences\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.80", ",", "0.45", ",", "0.12"}], "}"}]}], ",", 
       RowBox[{"\"\<DownstreamCapacities\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.60", ",", "0.20", ",", "0.06"}], "}"}]}], ",", 
       RowBox[{"\"\<ResistancePowers\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"4.", ",", "4.", ",", "4."}], "}"}]}], ",", 
       RowBox[{"\"\<DissipationRates\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.002", ",", "0.015", ",", "0.06", ",", "0.40"}], "}"}]}]}],
       "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AddInteractingMultiscaleReservoirs", "[", 
      RowBox[{"forcingBase_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "openThresholds", ",", "closeThresholds", ",", "gateResponses", ",", 
         "maximumTransferFractions", ",", "nonlinearReferences", ",", 
         "downstreamCapacities", ",", "resistancePowers", ",", 
         "dissipationRates", ",", "numberOfScales", ",", "numberOfTransfers", 
         ",", "coarseForcing", ",", "initialState", ",", "interactionStep", ",",
          "stateHistory", ",", "scaleStates", ",", "transferGates", ",", 
         "gateLatches", ",", "transferFluxes", ",", "dissipationFluxes", ",", 
         "downstreamAvailabilities", ",", "fineScaleDissipation"}], "}"}], ",", 
       RowBox[{
        RowBox[{"openThresholds", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<OpenThresholds\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"closeThresholds", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<CloseThresholds\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"gateResponses", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<GateResponses\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"maximumTransferFractions", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<MaximumTransferFractions\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"nonlinearReferences", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<NonlinearReferences\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"downstreamCapacities", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<DownstreamCapacities\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"resistancePowers", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<ResistancePowers\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"dissipationRates", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<DissipationRates\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"numberOfScales", "=", 
         RowBox[{"Length", "[", "dissipationRates", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"numberOfTransfers", "=", 
         RowBox[{"numberOfScales", "-", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"SameQ", "[", 
            RowBox[{
             RowBox[{"Length", "/@", 
              RowBox[{"{", 
               RowBox[{
               "openThresholds", ",", "closeThresholds", ",", "gateResponses",
                 ",", "maximumTransferFractions", ",", "nonlinearReferences", 
                ",", "downstreamCapacities", ",", "resistancePowers"}], 
               "}"}]}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"numberOfTransfers", ",", "7"}], "]"}]}], "]"}]}], ",", 
          
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidCascadeDimensions\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Every transfer parameter must have one fewer \
element than DissipationRates.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"And", "@@", 
            RowBox[{"MapThread", "[", 
             RowBox[{"Greater", ",", 
              RowBox[{"{", 
               RowBox[{"openThresholds", ",", "closeThresholds"}], "}"}]}], 
             "]"}]}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidThresholds\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Every opening threshold must exceed its closing \
threshold.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"gateResponses", ",", 
             RowBox[{
              RowBox[{"0.", "<", "#", "<=", "1."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidGateResponse\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Every gate response must satisfy 0 < response <= 1.\
\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
              "nonlinearReferences", ",", "downstreamCapacities", ",", 
               "resistancePowers"}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", ">", "0."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidPositiveParameter\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<References, capacities, and resistance powers must \
be positive.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"Plus", ",", 
               RowBox[{"{", 
                RowBox[{"dissipationRates", ",", 
                 RowBox[{"Append", "[", 
                  RowBox[{"maximumTransferFractions", ",", "0."}], "]"}]}], 
                "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", "<=", "1."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidActivityBudget\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Dissipation plus maximum outgoing transfer cannot \
exceed one.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coarseForcing", "=", 
         RowBox[{"forcingBase", "[", "\"\<CoarseForcing\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"initialState", "=", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Energy\>\"", "->", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", "numberOfScales"}], "]"}]}], ",", 
           RowBox[{"\"\<Gate\>\"", "->", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", "numberOfTransfers"}], "]"}]}], ",", 
           RowBox[{"\"\<Latch\>\"", "->", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", "numberOfTransfers"}], "]"}]}], ",", 
           RowBox[{"\"\<TransferFlux\>\"", "->", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", "numberOfTransfers"}], "]"}]}], ",", 
           RowBox[{"\"\<DissipationFlux\>\"", "->", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", "numberOfScales"}], "]"}]}], ",", 
           RowBox[{"\"\<DownstreamAvailability\>\"", "->", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1.", ",", "numberOfTransfers"}], "]"}]}]}], "|>"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"interactionStep", "[", 
          RowBox[{"state_Association", ",", 
           RowBox[{"forcing_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "energy", ",", "gate", ",", "latch", ",", "nextLatch", ",", 
             "nextGate", ",", "nonlinearActivation", ",", 
             "downstreamAvailability", ",", "currentTransferFlux", ",", 
             "currentDissipation", ",", "nextEnergy"}], "}"}], ",", 
           RowBox[{
            RowBox[{"energy", "=", 
             RowBox[{"state", "[", "\"\<Energy\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"gate", "=", 
             RowBox[{"state", "[", "\"\<Gate\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"latch", "=", 
             RowBox[{"state", "[", "\"\<Latch\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Each", " ", "transfer", " ", "gate", " ", "has", " ", "its", " ",
               "own", " ", 
              RowBox[{"hysteresis", "."}]}], "*)"}], 
            RowBox[{"nextLatch", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "upstreamEnergy", ",", "openThreshold", ",", 
                   "closeThreshold", ",", "previousLatch"}], "}"}], ",", 
                 RowBox[{"Which", "[", 
                  RowBox[{
                   RowBox[{"upstreamEnergy", ">=", "openThreshold"}], ",", 
                   "1.", ",", 
                   RowBox[{"upstreamEnergy", "<=", "closeThreshold"}], ",", 
                   "0.", ",", "True", ",", "previousLatch"}], "]"}]}], "]"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Most", "[", "energy", "]"}], ",", "openThresholds", 
                 ",", "closeThresholds", ",", "latch"}], "}"}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"nextGate", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "previousGate", ",", "targetLatch", ",", "response"}], 
                  "}"}], ",", 
                 RowBox[{"Clip", "[", 
                  RowBox[{
                   RowBox[{"previousGate", "+", 
                    RowBox[{"response", " ", 
                    RowBox[{"(", 
                    RowBox[{"targetLatch", "-", "previousGate"}], ")"}]}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"0.", ",", "1."}], "}"}]}], "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"gate", ",", "nextLatch", ",", "gateResponses"}], 
                "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Nonlinear", " ", "activation", " ", "is", " ", "approximately", 
              " ", 
              RowBox[{"E", "^", 
               RowBox[{"(", 
                RowBox[{"1", "/", "2"}], ")"}]}], " ", "at", " ", "low", " ", 
              
              RowBox[{"activity", ".", "Multiplication"}], " ", "by", " ", 
              "E", " ", "below", " ", "makes", " ", "the", " ", "resulting", " ",
               "flux", " ", "approximately", " ", 
              RowBox[{
               RowBox[{"E", "^", 
                RowBox[{"(", 
                 RowBox[{"3", "/", "2"}], ")"}]}], "."}]}], "*)"}], 
            RowBox[{"nonlinearActivation", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"upstreamEnergy", ",", "reference"}], "}"}], ",", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"upstreamEnergy", "/", "reference"}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"1.", "+", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"upstreamEnergy", "/", "reference"}], "]"}]}], 
                   ")"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Most", "[", "energy", "]"}], ",", 
                 "nonlinearReferences"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "A", " ", "loaded", " ", "downstream", " ", "scale", " ", 
              "resists", " ", "incoming", " ", 
              RowBox[{"transfer", "."}]}], "*)"}], 
            RowBox[{"downstreamAvailability", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "downstreamEnergy", ",", "capacity", ",", 
                   "resistancePower"}], "}"}], ",", 
                 RowBox[{"1.", "/", 
                  RowBox[{"(", 
                   RowBox[{"1.", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"downstreamEnergy", "/", "capacity"}], ")"}], "^",
                     "resistancePower"}]}], ")"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Rest", "[", "energy", "]"}], ",", 
                 "downstreamCapacities", ",", "resistancePowers"}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"currentTransferFlux", "=", 
             RowBox[{"maximumTransferFractions", "*", "nextGate", "*", 
              RowBox[{"Most", "[", "energy", "]"}], "*", 
              "nonlinearActivation", "*", "downstreamAvailability"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"currentDissipation", "=", 
             RowBox[{"dissipationRates", " ", "energy"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Simultaneous", " ", "conservative", " ", 
              RowBox[{"transfer", ":", 
               RowBox[{
               "outgoing", " ", "activity", " ", "leaves", " ", "one", " ", 
                "scale", " ", "and", " ", "enters", " ", "the", " ", "next", " ",
                 "scale"}]}]}], "*)"}], 
            RowBox[{"nextEnergy", "=", 
             RowBox[{"energy", "-", "currentDissipation", "-", 
              RowBox[{"Append", "[", 
               RowBox[{"currentTransferFlux", ",", "0."}], "]"}], "+", 
              RowBox[{"Prepend", "[", 
               RowBox[{"currentTransferFlux", ",", "0."}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"nextEnergy", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+=", "forcing"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"nextEnergy", "=", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"0.", ",", "#"}], "]"}], "&"}], ",", "nextEnergy"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Energy\>\"", "->", "nextEnergy"}], ",", 
              RowBox[{"\"\<Gate\>\"", "->", "nextGate"}], ",", 
              RowBox[{"\"\<Latch\>\"", "->", "nextLatch"}], ",", 
              RowBox[{"\"\<TransferFlux\>\"", "->", "currentTransferFlux"}], ",", 
              RowBox[{"\"\<DissipationFlux\>\"", "->", "currentDissipation"}],
               ",", 
              
              RowBox[{"\"\<DownstreamAvailability\>\"", "->", 
               "downstreamAvailability"}]}], "|>"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stateHistory", "=", 
         RowBox[{"Rest", "@", 
          RowBox[{"FoldList", "[", 
           RowBox[{
           "interactionStep", ",", "initialState", ",", "coarseForcing"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"scaleStates", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Energy\>\"", "]"}], "&"}], ")"}], "/@", 
          "stateHistory"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"transferGates", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Gate\>\"", "]"}], "&"}], ")"}], "/@", 
          "stateHistory"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gateLatches", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Latch\>\"", "]"}], "&"}], ")"}], "/@", 
          "stateHistory"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"transferFluxes", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "\"\<TransferFlux\>\"", "]"}], "&"}], ")"}], "/@",
           "stateHistory"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dissipationFluxes", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "\"\<DissipationFlux\>\"", "]"}], "&"}], ")"}], 
          "/@", "stateHistory"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"downstreamAvailabilities", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", "\"\<DownstreamAvailability\>\"", "]"}], "&"}], 
           ")"}], "/@", "stateHistory"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fineScaleDissipation", "=", 
         RowBox[{"dissipationFluxes", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Join", "[", 
         RowBox[{"forcingBase", ",", 
          RowBox[{"<|", 
           RowBox[{
            
            RowBox[{"\"\<Stage\>\"", 
             "->", "\"\<InteractingMultiscaleReservoirs\>\""}], ",", 
            RowBox[{"\"\<Version\>\"", "->", "\"\<1.2.0\>\""}], ",", 
            
            RowBox[{"\"\<ParentStage\>\"", 
             "->", "\"\<BoundedContinuousCoarseForcing\>\""}], ",", 
            
            RowBox[{"\"\<ReplacesStage\>\"", 
             "->", "\"\<HystereticCoarseStorageRelease\>\""}], ",", 
            RowBox[{"\"\<ScaleStates\>\"", "->", "scaleStates"}], ",", 
            RowBox[{"\"\<TransferGates\>\"", "->", "transferGates"}], ",", 
            RowBox[{"\"\<GateLatches\>\"", "->", "gateLatches"}], ",", 
            RowBox[{"\"\<TransferFluxes\>\"", "->", "transferFluxes"}], ",", 
            RowBox[{"\"\<DissipationFluxes\>\"", "->", "dissipationFluxes"}], 
            ",", 
            
            RowBox[{"\"\<DownstreamAvailabilities\>\"", "->", 
             "downstreamAvailabilities"}], ",", 
            
            RowBox[{"\"\<FineScaleDissipation\>\"", "->", 
             "fineScaleDissipation"}], ",", 
            RowBox[{"\"\<CascadeActivity\>\"", "->", "fineScaleDissipation"}],
             ",", 
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"forcingBase", "[", "\"\<Parameters\>\"", "]"}], ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<NumberOfScales\>\"", "->", "numberOfScales"}], ",", 
                 RowBox[{"\"\<OpenThresholds\>\"", "->", "openThresholds"}], ",", 
                 RowBox[{"\"\<CloseThresholds\>\"", "->", "closeThresholds"}],
                  ",", 
                 RowBox[{"\"\<GateResponses\>\"", "->", "gateResponses"}], ",", 
                 
                 RowBox[{"\"\<MaximumTransferFractions\>\"", "->", 
                  "maximumTransferFractions"}], ",", 
                 
                 RowBox[{"\"\<NonlinearReferences\>\"", "->", 
                  "nonlinearReferences"}], ",", 
                 
                 RowBox[{"\"\<DownstreamCapacities\>\"", "->", 
                  "downstreamCapacities"}], ",", 
                 
                 RowBox[{"\"\<ResistancePowers\>\"", "->", 
                  "resistancePowers"}], ",", 
                 
                 RowBox[{"\"\<DissipationRates\>\"", "->", 
                  "dissipationRates"}], ",", 
                 
                 RowBox[{"\"\<PeakTimingRule\>\"", 
                  "->", "\"\<None: fine-scale bursts emerge from interacting \
states\>\""}]}], "|>"}]}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"interactingCascadeCore", "=", 
     RowBox[{"AddInteractingMultiscaleReservoirs", "[", 
      RowBox[{"endogenousForcingBase", ",", 
       RowBox[{"\"\<OpenThresholds\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.80", ",", "0.45", ",", "0.12"}], "}"}]}], ",", 
       RowBox[{"\"\<CloseThresholds\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.45", ",", "0.10", ",", "0.025"}], "}"}]}], ",", 
       RowBox[{"\"\<GateResponses\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.22", ",", "0.35", ",", "0.55"}], "}"}]}], ",", 
       RowBox[{"\"\<MaximumTransferFractions\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.45", ",", "0.60", ",", "0.75"}], "}"}]}], ",", 
       RowBox[{"\"\<NonlinearReferences\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1.80", ",", "0.45", ",", "0.12"}], "}"}]}], ",", 
       RowBox[{"\"\<DownstreamCapacities\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.60", ",", "0.20", ",", "0.06"}], "}"}]}], ",", 
       RowBox[{"\"\<ResistancePowers\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"4.", ",", "4.", ",", "4."}], "}"}]}], ",", 
       RowBox[{"\"\<DissipationRates\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.002", ",", "0.015", ",", "0.06", ",", "0.40"}], "}"}]}]}],
       "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Head", "[", "interactingCascadeCore", "]"}]}]}]], "Input",
