Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Adding", " ", "a", " ", "proper", " ", "distributino", " ", "for", " ", 
    "peak", " ", "severity"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "AddPeakSeverityDistribution", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AddPeakSeverityDistribution", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<SeverityLogMean\>\"", "->", "0.44"}], ",", 
       RowBox[{"\"\<SeverityLogStandardDeviation\>\"", "->", "0.55"}], ",", 
       RowBox[{"\"\<SeveritySeed\>\"", "->", "20260819"}], ",", 
       RowBox[{"\"\<RandomMethod\>\"", "->", "\"\<MersenneTwister\>\""}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AddPeakSeverityDistribution", "[", 
      RowBox[{"peakCore_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "severityLogMean", ",", "severityLogStandardDeviation", ",", 
         "severitySeed", ",", "randomMethod", ",", "length", ",", 
         "peakProbability", ",", "peakIndicator", ",", "gaussianSource", ",", 
         "severityExcess", ",", "severityMultiplier", ",", 
         "meanSeverityExcess", ",", "secondMomentSeverityExcess", ",", 
         "eventSeveritySecondMoment", ",", "varianceNormalization", ",", 
         "relativeActivityScale", ",", "severitySignal"}], "}"}], ",", 
       RowBox[{
        RowBox[{"severityLogMean", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<SeverityLogMean\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"severityLogStandardDeviation", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<SeverityLogStandardDeviation\>\"", 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"severitySeed", "=", 
         RowBox[{"OptionValue", "[", "\"\<SeveritySeed\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"randomMethod", "=", 
         RowBox[{"OptionValue", "[", "\"\<RandomMethod\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"length", "=", 
         RowBox[{"peakCore", "[", "\"\<Length\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peakProbability", "=", 
         RowBox[{
          RowBox[{"peakCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<PeakProbability\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"peakIndicator", "=", 
         RowBox[{"peakCore", "[", "\"\<PeakIndicator\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gaussianSource", "=", 
         RowBox[{"peakCore", "[", "\"\<GaussianSource\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Positive", " ", "excess", " ", 
           RowBox[{"severity", ".", "At"}], " ", "a", " ", 
           RowBox[{"peak", ":", "multiplier"}]}], "=", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"LogNormal", " ", "draw", " ", "Outside", " ", "a", " ", 
             RowBox[{"peak", ":", "multiplier"}]}]}], "=", "1"}]}], "*)"}], 
        RowBox[{"severityExcess", "=", 
         RowBox[{"BlockRandom", "[", 
          RowBox[{
           RowBox[{"SeedRandom", "[", 
            RowBox[{"severitySeed", ",", 
             RowBox[{"Method", "->", "randomMethod"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{
             RowBox[{"LogNormalDistribution", "[", 
              RowBox[{
              "severityLogMean", ",", "severityLogStandardDeviation"}], "]"}],
              ",", "length"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"severityMultiplier", "=", 
         RowBox[{"1.", "+", 
          RowBox[{"peakIndicator", " ", "severityExcess"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Analytical", " ", "moments", " ", "of", " ", 
          RowBox[{"Y", "~", 
           RowBox[{"LogNormalDistribution", "[", 
            RowBox[{"mu", ",", "sigma"}], "]"}]}]}], "*)"}], 
        RowBox[{"meanSeverityExcess", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{"severityLogMean", "+", 
           RowBox[{
            RowBox[{"severityLogStandardDeviation", "^", "2"}], "/", "2."}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"secondMomentSeverityExcess", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"2.", " ", "severityLogMean"}], "+", 
           RowBox[{"2.", " ", 
            RowBox[{"severityLogStandardDeviation", "^", "2"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"M", "=", 
          RowBox[{"1", "+", 
           RowBox[{"Y", " ", "during", " ", "an", " ", "event"}]}]}], "*)"}], 
        
        RowBox[{"eventSeveritySecondMoment", "=", 
         RowBox[{"1.", "+", 
          RowBox[{"2.", " ", "meanSeverityExcess"}], "+", 
          "secondMomentSeverityExcess"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"Preserve", " ", 
            RowBox[{"E", "[", 
             RowBox[{"Signal", "^", "2"}], "]"}]}], "=", 
           RowBox[{
            RowBox[{"1", " ", 
             RowBox[{"theoretically", ".", "This"}], " ", "is", " ", 
             "model"}], "-", 
            RowBox[{"level", " ", "normalization"}]}]}], ",", 
          RowBox[{
          "not", " ", "normalization", " ", "of", " ", "the", " ", "realized",
            " ", 
           RowBox[{"sample", "."}]}]}], "*)"}], 
        RowBox[{"varianceNormalization", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1.", "-", "peakProbability"}], ")"}], "+", 
           RowBox[{"peakProbability", " ", "eventSeveritySecondMoment"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"relativeActivityScale", "=", 
         RowBox[{"severityMultiplier", "/", "varianceNormalization"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"severitySignal", "=", 
         RowBox[{"relativeActivityScale", " ", "gaussianSource"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"peakCore", ",", 
          RowBox[{"<|", 
           RowBox[{
            
            RowBox[{"\"\<Model\>\"", 
             "->", "\"\<OneDimensionalTurbulence\>\""}], ",", 
            
            RowBox[{"\"\<Stage\>\"", 
             "->", "\"\<PeakSeverityDistribution\>\""}], ",", 
            RowBox[{"\"\<Version\>\"", "->", "\"\<0.3\>\""}], ",", 
            
            RowBox[{"\"\<ParentStage\>\"", 
             "->", "\"\<IndependentPeakFrequency\>\""}], ",", 
            RowBox[{"\"\<Signal\>\"", "->", "severitySignal"}], ",", 
            RowBox[{"\"\<Activity\>\"", "->", 
             RowBox[{"severitySignal", "^", "2"}]}], ",", 
            RowBox[{"\"\<PeakSeverityExcess\>\"", "->", "severityExcess"}], ",", 
            
            RowBox[{"\"\<PeakSeverityMultiplier\>\"", "->", 
             "severityMultiplier"}], ",", 
            
            RowBox[{"\"\<ConditionalScale\>\"", "->", 
             "relativeActivityScale"}], ",", 
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"peakCore", "[", "\"\<Parameters\>\"", "]"}], ",", 
               RowBox[{"<|", 
                RowBox[{
                 
                 RowBox[{"\"\<SeverityDistribution\>\"", 
                  "->", "\"\<1 + LogNormalDistribution[mu,sigma]\>\""}], ",", 
                 
                 RowBox[{"\"\<SeverityLogMean\>\"", "->", "severityLogMean"}],
                  ",", 
                 
                 RowBox[{"\"\<SeverityLogStandardDeviation\>\"", "->", 
                  "severityLogStandardDeviation"}], ",", 
                 RowBox[{"\"\<SeveritySeed\>\"", "->", "severitySeed"}], ",", 
                 
                 RowBox[{"\"\<ExpectedEventSeverity\>\"", "->", 
                  RowBox[{"1.", "+", "meanSeverityExcess"}]}], ",", 
                 RowBox[{"\"\<ExpectedEventSeverityRMS\>\"", "->", 
                  RowBox[{"Sqrt", "[", "eventSeveritySecondMoment", "]"}]}], ",", 
                 
                 RowBox[{"\"\<VarianceNormalization\>\"", "->", 
                  "varianceNormalization"}], ",", 
                 RowBox[{"\"\<TheoreticalSignalVariance\>\"", "->", "1."}]}], 
                "|>"}]}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakSeverityLogMean", "=", "0.44"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakSeverityLogStandardDeviation", "=", "0.55"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakSeveritySeed", "=", "20260819"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakSeverityCore", "=", 
     RowBox[{"AddPeakSeverityDistribution", "[", 
      RowBox[{"peakFrequencyCore", ",", 
       RowBox[{"\"\<SeverityLogMean\>\"", "->", "peakSeverityLogMean"}], ",", 
       
       RowBox[{"\"\<SeverityLogStandardDeviation\>\"", "->", 
        "peakSeverityLogStandardDeviation"}], ",", 
       RowBox[{"\"\<SeveritySeed\>\"", "->", "peakSeveritySeed"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakSeverityMarketBase", "=", 
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"peakSeverityCore", ",", 
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"peakSeverityRelativeScale", "=", 
     RowBox[{"peakSeverityCore", "[", "\"\<ConditionalScale\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakSeverityPeriodScale", "=", 
     RowBox[{
      RowBox[{
      "peakSeverityMarketBase", "[", "\"\<MarketParameters\>\"", "]"}], 
      "[", "\"\<PeriodScale\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakSeverityResult", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"peakSeverityMarketBase", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Volatility\>\"", "->", 
          RowBox[{
          "peakSeverityPeriodScale", " ", "peakSeverityRelativeScale"}]}], ",", 
         RowBox[{"\"\<RelativeVolatility\>\"", "->", 
          "peakSeverityRelativeScale"}]}], "|>"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9959540003741093`*^9, 3.995954019987625*^9}, {
  3.9959540822849903`*^9, 3.995954082923068*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"c2100055-6f22-4feb-8b8c-4d8e5a37895a"],

