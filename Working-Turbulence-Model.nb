Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Clearing", " ", "and", " ", "adding", " ", "linear", " ", "dissipative", " ",
     "cascade"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "AddDrivenMultiscaleCascade", ",", "AddDrivenLinearDissipativeCascade", ",",
       "AddDrivenNonlinearMultiscaleCascade", ",", "multiscaleCascadeCore", ",",
       "multiscaleCascadeResult", ",", "multiscaleCascadeMarketBase", ",", 
      "linearDissipativeCascadeCore", ",", "linearDissipativeCascadeResult", ",",
       "linearDissipativeCascadeMarketBase", ",", "nonlinearCascadeCore", ",",
       "nonlinearCascadeResult", ",", "nonlinearCascadeMarketBase"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "AddDrivenLinearDissipativeCascade", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AddDrivenLinearDissipativeCascade", "]"}], "=", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<TransferRates\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.08", ",", "0.16", ",", "0.28"}], "}"}]}], ",", 
       RowBox[{"\"\<DissipationRates\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", "0.03", ",", "0.08", ",", "0.35"}], "}"}]}], ",", 
       RowBox[{"\"\<ObservationWeights\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.10", ",", "0.20", ",", "0.30", ",", "0.40"}], "}"}]}], ",", 
       RowBox[{"\"\<ActivityCoupling\>\"", "->", "2."}], ",", 
       RowBox[{"\"\<MomentIterations\>\"", "->", "1000"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AddDrivenLinearDissipativeCascade", "[", 
      RowBox[{"persistentCore_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "transferRates", ",", "dissipationRates", ",", "observationWeights", ",",
          "activityCoupling", ",", "momentIterations", ",", "numberOfScales", 
         ",", "peakProbability", ",", "severityLogMean", ",", 
         "severityLogStandardDeviation", ",", "peakImpulse", ",", 
         "gaussianSource", ",", "meanSeverityExcess", ",", 
         "secondMomentSeverityExcess", ",", "meanImpulse", ",", 
         "varianceImpulse", ",", "transitionMatrix", ",", "forcingVector", ",",
          "innovationCovariance", ",", "stationaryMeanState", ",", 
         "stationaryCovariance", ",", "linearScaleStates", ",", 
         "linearTransferFluxes", ",", "dissipationFluxes", ",", 
         "weightedScaleActivity", ",", "stationaryMeanActivity", ",", 
         "stationaryVarianceActivity", ",", "stationarySecondMomentActivity", 
         ",", "varianceNormalization", ",", "relativeActivityScale", ",", 
         "linearCascadeSignal", ",", "baseParameters"}], "}"}], ",", 
       RowBox[{
        RowBox[{"transferRates", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<TransferRates\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"dissipationRates", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<DissipationRates\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"observationWeights", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<ObservationWeights\>\"", "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"activityCoupling", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<ActivityCoupling\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"momentIterations", "=", 
         RowBox[{"OptionValue", "[", "\"\<MomentIterations\>\"", "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"numberOfScales", "=", 
         RowBox[{"Length", "[", "dissipationRates", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "transferRates", "]"}], "!=", 
           RowBox[{"numberOfScales", "-", "1"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidTransferRates\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<TransferRates must have one fewer element than \
DissipationRates.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "observationWeights", "]"}], "!=", 
           "numberOfScales"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidObservationWeights\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<ObservationWeights must have one element per scale.\
\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", "observationWeights", "]"}], "<=", "0."}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidObservationWeights\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<ObservationWeights must have a positive \
total.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{"transferRates", ",", "dissipationRates"}], "]"}], ",", 
             
             RowBox[{
              RowBox[{"#", ">=", "0."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<NegativeRate\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Transfer and dissipation rates must be \
non-negative.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"Plus", ",", 
               RowBox[{"{", 
                RowBox[{"dissipationRates", ",", 
                 RowBox[{"Append", "[", 
                  RowBox[{"transferRates", ",", "0."}], "]"}]}], "}"}]}], 
              "]"}], ",", 
             RowBox[{
              RowBox[{"#", "<=", "1."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidActivityBudget\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Dissipation plus outgoing transfer cannot exceed \
one at any scale.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"observationWeights", "=", 
         RowBox[{"observationWeights", "/", 
          RowBox[{"Total", "[", "observationWeights", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peakProbability", "=", 
         RowBox[{
          RowBox[{"persistentCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<PeakProbability\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"severityLogMean", "=", 
         RowBox[{
          RowBox[{"persistentCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<SeverityLogMean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"severityLogStandardDeviation", "=", 
         RowBox[{
          RowBox[{"persistentCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<SeverityLogStandardDeviation\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peakImpulse", "=", 
         RowBox[{"persistentCore", "[", "\"\<PeakImpulse\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gaussianSource", "=", 
         RowBox[{"persistentCore", "[", "\"\<GaussianSource\>\"", "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"meanSeverityExcess", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{"severityLogMean", "+", 
           RowBox[{
            RowBox[{"severityLogStandardDeviation", "^", "2"}], "/", "2."}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"secondMomentSeverityExcess", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"2.", " ", "severityLogMean"}], "+", 
           RowBox[{"2.", " ", 
            RowBox[{"severityLogStandardDeviation", "^", "2"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"meanImpulse", "=", 
         RowBox[{"peakProbability", " ", "meanSeverityExcess"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varianceImpulse", "=", 
         RowBox[{
          RowBox[{"peakProbability", " ", "secondMomentSeverityExcess"}], "-", 
          RowBox[{"meanImpulse", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Linear", " ", "state", " ", 
           RowBox[{"equation", ":", 
            RowBox[{"E", "[", "t", "]"}]}]}], "=", 
          RowBox[{
           RowBox[{"A", ".", 
            RowBox[{"E", "[", 
             RowBox[{"t", "-", "1"}], "]"}]}], "+", 
           RowBox[{"b", " ", 
            RowBox[{"forcing", "[", "t", "]"}]}]}]}], "*)"}], 
        RowBox[{"transitionMatrix", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"1.", "-", "dissipationRates", "-", 
           RowBox[{"Append", "[", 
            RowBox[{"transferRates", ",", "0."}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"transitionMatrix", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"scale", "+", "1"}], ",", "scale"}], "]"}], "]"}], "=", 
           
           RowBox[{"transferRates", "[", 
            RowBox[{"[", "scale", "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"scale", ",", "1", ",", 
            RowBox[{"numberOfScales", "-", "1"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Eigenvalues", "[", "transitionMatrix", "]"}], "]"}], 
            "]"}], ">=", "1."}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<UnstableTransitionMatrix\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<The cascade transition matrix is not \
stationary.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"forcingVector", "=", 
         RowBox[{"UnitVector", "[", 
          RowBox[{"numberOfScales", ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stationaryMeanState", "=", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "numberOfScales", "]"}], "-", 
            "transitionMatrix"}], ",", 
           RowBox[{"forcingVector", " ", "meanImpulse"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"innovationCovariance", "=", 
         RowBox[{"varianceImpulse", " ", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", "forcingVector", ",", "forcingVector"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"stationaryCovariance", "=", 
         RowBox[{"Nest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"transitionMatrix", ".", "#", ".", 
              RowBox[{"Transpose", "[", "transitionMatrix", "]"}]}], "+", 
             "innovationCovariance"}], "&"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"{", 
              RowBox[{"numberOfScales", ",", "numberOfScales"}], "}"}]}], 
            "]"}], ",", "momentIterations"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"linearScaleStates", "=", 
         RowBox[{"Rest", "@", 
          RowBox[{"FoldList", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"transitionMatrix", ".", "#1"}], "+", 
              RowBox[{"forcingVector", " ", "#2"}]}], "&"}], ",", 
            "stationaryMeanState", ",", "peakImpulse"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"linearTransferFluxes", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", " ", "transferRates"}], "&"}], ",", 
           RowBox[{"linearScaleStates", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"1", ";;", 
               RowBox[{"numberOfScales", "-", "1"}]}]}], "]"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dissipationFluxes", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", " ", "dissipationRates"}], "&"}], ",", 
           "linearScaleStates"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"weightedScaleActivity", "=", 
         RowBox[{"linearScaleStates", ".", "observationWeights"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stationaryMeanActivity", "=", 
         RowBox[{"observationWeights", ".", "stationaryMeanState"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stationaryVarianceActivity", "=", 
         RowBox[{
         "observationWeights", ".", "stationaryCovariance", ".", 
          "observationWeights"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"stationarySecondMomentActivity", "=", 
         RowBox[{"stationaryVarianceActivity", "+", 
          RowBox[{"stationaryMeanActivity", "^", "2"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varianceNormalization", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1.", "+", 
           RowBox[{
           "2.", " ", "activityCoupling", " ", "stationaryMeanActivity"}], "+", 
           RowBox[{
            RowBox[{"activityCoupling", "^", "2"}], " ", 
            "stationarySecondMomentActivity"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"relativeActivityScale", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "+", 
            RowBox[{"activityCoupling", " ", "weightedScaleActivity"}]}], 
           ")"}], "/", "varianceNormalization"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"linearCascadeSignal", "=", 
         RowBox[{"relativeActivityScale", " ", "gaussianSource"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"baseParameters", "=", 
         RowBox[{"KeyDrop", "[", 
          RowBox[{
           RowBox[{"persistentCore", "[", "\"\<Parameters\>\"", "]"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Persistence\>\"", ",", "\"\<ActivityHalfLife\>\"", 
             ",", "\"\<StationaryMeanActivity\>\"", 
             ",", "\"\<StationaryVarianceActivity\>\"", 
             ",", "\"\<VarianceNormalization\>\"", 
             ",", "\"\<TheoreticalSignalVariance\>\""}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"persistentCore", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<PersistentActivity\>\"", 
              ",", "\"\<ConditionalScale\>\"", ",", "\"\<Signal\>\"", 
              ",", "\"\<Activity\>\""}], "}"}]}], "]"}], ",", 
          RowBox[{"<|", 
           RowBox[{
            
            RowBox[{"\"\<Model\>\"", 
             "->", "\"\<OneDimensionalTurbulence\>\""}], ",", 
            
            RowBox[{"\"\<Stage\>\"", 
             "->", "\"\<DrivenLinearDissipativeCascade\>\""}], ",", 
            RowBox[{"\"\<Version\>\"", "->", "\"\<0.5\>\""}], ",", 
            
            RowBox[{"\"\<ParentStage\>\"", 
             "->", "\"\<PersistentPeakEpisodes\>\""}], ",", 
            RowBox[{"\"\<ForcingType\>\"", "->", "\"\<ExternallyDriven\>\""}],
             ",", 
            RowBox[{"\"\<TransferType\>\"", "->", "\"\<Linear\>\""}], ",", 
            
            RowBox[{"\"\<DissipationType\>\"", 
             "->", "\"\<LinearScaleDependent\>\""}], ",", 
            RowBox[{"\"\<Signal\>\"", "->", "linearCascadeSignal"}], ",", 
            RowBox[{"\"\<Activity\>\"", "->", 
             RowBox[{"linearCascadeSignal", "^", "2"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
             "Stable", " ", "keys", " ", "for", " ", "every", " ", "future", " ",
               "cascade", " ", "stage"}], "*)"}], 
            RowBox[{"\"\<ScaleStates\>\"", "->", "linearScaleStates"}], ",", 
            RowBox[{"\"\<TransferFluxes\>\"", "->", "linearTransferFluxes"}], 
            ",", 
            RowBox[{"\"\<DissipationFluxes\>\"", "->", "dissipationFluxes"}], 
            ",", 
            
            RowBox[{"\"\<CascadeActivity\>\"", "->", 
             "weightedScaleActivity"}], ",", 
            
            RowBox[{"\"\<ConditionalScale\>\"", "->", 
             "relativeActivityScale"}], ",", 
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{"baseParameters", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<NumberOfScales\>\"", "->", "numberOfScales"}], ",", 
                 RowBox[{"\"\<TransferRates\>\"", "->", "transferRates"}], ",", 
                 
                 RowBox[{"\"\<DissipationRates\>\"", "->", 
                  "dissipationRates"}], ",", 
                 
                 RowBox[{"\"\<ObservationWeights\>\"", "->", 
                  "observationWeights"}], ",", 
                 
                 RowBox[{"\"\<ActivityCoupling\>\"", "->", 
                  "activityCoupling"}], ",", 
                 
                 RowBox[{"\"\<StationaryMeanScaleState\>\"", "->", 
                  "stationaryMeanState"}], ",", 
                 
                 RowBox[{"\"\<StationaryMeanCascadeActivity\>\"", "->", 
                  "stationaryMeanActivity"}], ",", 
                 
                 RowBox[{"\"\<StationaryVarianceCascadeActivity\>\"", "->", 
                  "stationaryVarianceActivity"}], ",", 
                 
                 RowBox[{"\"\<VarianceNormalization\>\"", "->", 
                  "varianceNormalization"}], ",", 
                 RowBox[{"\"\<TheoreticalSignalVariance\>\"", "->", "1."}]}], 
                "|>"}]}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearDissipativeTransferRates", "=", 
     RowBox[{"{", 
      RowBox[{"0.08", ",", "0.16", ",", "0.28"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"linearDissipativeRates", "=", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", "0.03", ",", "0.08", ",", "0.35"}], "}"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearDissipativeObservationWeights", "=", 
     RowBox[{"{", 
      RowBox[{"0.10", ",", "0.20", ",", "0.30", ",", "0.40"}], "}"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"linearDissipativeActivityCoupling", "=", "2."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearDissipativeCascadeCore", "=", 
     RowBox[{"AddDrivenLinearDissipativeCascade", "[", 
      RowBox[{"persistentClusterCore", ",", 
       RowBox[{"\"\<TransferRates\>\"", "->", 
        "linearDissipativeTransferRates"}], ",", 
       RowBox[{"\"\<DissipationRates\>\"", "->", "linearDissipativeRates"}], ",", 
       RowBox[{"\"\<ObservationWeights\>\"", "->", 
        "linearDissipativeObservationWeights"}], ",", 
       RowBox[{"\"\<ActivityCoupling\>\"", "->", 
        "linearDissipativeActivityCoupling"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Dataset", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Stage\>\"", "->", 
       RowBox[{"linearDissipativeCascadeCore", "[", "\"\<Stage\>\"", "]"}]}], 
      ",", 
      RowBox[{"\"\<TransferType\>\"", "->", 
       RowBox[{
       "linearDissipativeCascadeCore", "[", "\"\<TransferType\>\"", "]"}]}], ",", 
      RowBox[{"\"\<Dimensions\>\"", "->", 
       RowBox[{"Dimensions", "[", 
        RowBox[{
        "linearDissipativeCascadeCore", "[", "\"\<ScaleStates\>\"", "]"}], 
        "]"}]}], ",", 
      RowBox[{"\"\<Failure\>\"", "->", 
       RowBox[{"FailureQ", "[", "linearDissipativeCascadeCore", "]"}]}]}], 
     "|>"}], "]"}], "\[IndentingNewLine]"}]}]], "Input",
