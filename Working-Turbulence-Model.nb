Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Market", " ", "adapter", " ", "for", " ", "non", " ", "linear", " ", 
    "multiscale", " ", "cascade"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nonlinearCascadeMarketBase", "=", 
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"nonlinearCascadeCore", ",", 
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"nonlinearCascadeRelativeScale", "=", 
     RowBox[{"nonlinearCascadeCore", "[", "\"\<ConditionalScale\>\"", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nonlinearCascadePeriodScale", "=", 
     RowBox[{
      RowBox[{
      "nonlinearCascadeMarketBase", "[", "\"\<MarketParameters\>\"", "]"}], 
      "[", "\"\<PeriodScale\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nonlinearCascadeResult", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"nonlinearCascadeMarketBase", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Volatility\>\"", "->", 
          RowBox[{
          "nonlinearCascadePeriodScale", "*", 
           "nonlinearCascadeRelativeScale"}]}], ",", 
         RowBox[{"\"\<RelativeVolatility\>\"", "->", 
          "nonlinearCascadeRelativeScale"}]}], "|>"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.995956655279687*^9, 3.9959566766271887`*^9}, {
   3.9959567363395157`*^9, 3.995956741208879*^9}, {3.99595783307018*^9, 
   3.995957835718479*^9}, {3.9959580082846317`*^9, 3.995958008605795*^9}, 
