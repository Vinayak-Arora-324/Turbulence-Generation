Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Now", " ", "adding", " ", "persistence"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "AddPersistentPeakEpisodes", "]"}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AddPersistentPeakEpisodes", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Persistence\>\"", "->", "0.85"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AddPersistentPeakEpisodes", "[", 
      RowBox[{"severityCore_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "persistence", ",", "peakProbability", ",", "severityLogMean", ",", 
         "severityLogStandardDeviation", ",", "peakIndicator", ",", 
         "severityExcess", ",", "gaussianSource", ",", "peakImpulse", ",", 
         "meanSeverityExcess", ",", "secondMomentSeverityExcess", ",", 
         "meanImpulse", ",", "varianceImpulse", ",", "stationaryMeanActivity",
          ",", "stationaryVarianceActivity", ",", 
         "stationarySecondMomentActivity", ",", "varianceNormalization", ",", 
         "initialActivity", ",", "persistentActivity", ",", 
         "relativeActivityScale", ",", "persistentSignal", ",", 
         "activityHalfLife"}], "}"}], ",", 
       RowBox[{
        RowBox[{"persistence", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<Persistence\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"persistence", "<", "0."}], "||", 
           RowBox[{"persistence", ">=", "1."}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidPersistence\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Persistence must satisfy 0 <= rho < 1.\>\""}], 
              "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"peakProbability", "=", 
         RowBox[{
          RowBox[{"severityCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<PeakProbability\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"severityLogMean", "=", 
         RowBox[{
          RowBox[{"severityCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<SeverityLogMean\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"severityLogStandardDeviation", "=", 
         RowBox[{
          RowBox[{"severityCore", "[", "\"\<Parameters\>\"", "]"}], 
          "[", "\"\<SeverityLogStandardDeviation\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peakIndicator", "=", 
         RowBox[{"severityCore", "[", "\"\<PeakIndicator\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"severityExcess", "=", 
         RowBox[{"severityCore", "[", "\"\<PeakSeverityExcess\>\"", "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"gaussianSource", "=", 
         RowBox[{"severityCore", "[", "\"\<GaussianSource\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Existing", " ", "event", " ", "times", " ", "and", " ", 
          "severities", " ", "are", " ", 
          RowBox[{"reused", ".", "No"}], " ", "new", " ", "random", " ", 
          "values", " ", "are", " ", 
          RowBox[{"introduced", "."}]}], "*)"}], 
        RowBox[{"peakImpulse", "=", 
         RowBox[{"peakIndicator", " ", "severityExcess"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meanSeverityExcess", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{"severityLogMean", "+", 
           RowBox[{
            RowBox[{"severityLogStandardDeviation", "^", "2"}], "/", "2."}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"secondMomentSeverityExcess", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"2.", " ", "severityLogMean"}], "+", 
           RowBox[{"2.", " ", 
            RowBox[{"severityLogStandardDeviation", "^", "2"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"meanImpulse", "=", 
         RowBox[{"peakProbability", " ", "meanSeverityExcess"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"varianceImpulse", "=", 
         RowBox[{
          RowBox[{"peakProbability", " ", "secondMomentSeverityExcess"}], "-", 
          RowBox[{"meanImpulse", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Stationary", " ", "moments", " ", 
           RowBox[{"of", ":", 
            RowBox[{"H", "[", "t", "]"}]}]}], "=", 
          RowBox[{
           RowBox[{"persistence", " ", 
            RowBox[{"H", "[", 
             RowBox[{"t", "-", "1"}], "]"}]}], "+", 
           RowBox[{"impulse", "[", "t", "]"}]}]}], "*)"}], 
        RowBox[{"stationaryMeanActivity", "=", 
         RowBox[{"meanImpulse", "/", 
          RowBox[{"(", 
           RowBox[{"1.", "-", "persistence"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stationaryVarianceActivity", "=", 
         RowBox[{"varianceImpulse", "/", 
          RowBox[{"(", 
           RowBox[{"1.", "-", 
            RowBox[{"persistence", "^", "2"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stationarySecondMomentActivity", "=", 
         RowBox[{"stationaryVarianceActivity", "+", 
          RowBox[{"stationaryMeanActivity", "^", "2"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Preserve", " ", "theoretical", " ", 
           RowBox[{"E", "[", 
            RowBox[{"Signal", "^", "2"}], "]"}]}], "=", "1."}], "*)"}], 
        RowBox[{"varianceNormalization", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1.", "+", 
           RowBox[{"2.", " ", "stationaryMeanActivity"}], "+", 
           "stationarySecondMomentActivity"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Start", " ", "at", " ", "the", " ", "stationary", " ", "mean", " ", 
          "to", " ", "reduce", " ", "startup", " ", 
          RowBox[{"transients", "."}]}], "*)"}], 
        RowBox[{"initialActivity", "=", "stationaryMeanActivity"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"persistentActivity", "=", 
         RowBox[{"Rest", "@", 
          RowBox[{"FoldList", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"persistence", " ", "#1"}], "+", "#2"}], "&"}], ",", 
            "initialActivity", ",", "peakImpulse"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"relativeActivityScale", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "+", "persistentActivity"}], ")"}], "/", 
          "varianceNormalization"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"persistentSignal", "=", 
         RowBox[{"relativeActivityScale", " ", "gaussianSource"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"activityHalfLife", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"persistence", "==", "0."}], ",", "0.", ",", 
           RowBox[{
            RowBox[{"Log", "[", "0.5", "]"}], "/", 
            RowBox[{"Log", "[", "persistence", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"severityCore", ",", 
          RowBox[{"<|", 
           RowBox[{
            
            RowBox[{"\"\<Model\>\"", 
             "->", "\"\<OneDimensionalTurbulence\>\""}], ",", 
            RowBox[{"\"\<Stage\>\"", "->", "\"\<PersistentPeakEpisodes\>\""}],
             ",", 
            RowBox[{"\"\<Version\>\"", "->", "\"\<0.4\>\""}], ",", 
            
            RowBox[{"\"\<ParentStage\>\"", 
             "->", "\"\<PeakSeverityDistribution\>\""}], ",", 
            RowBox[{"\"\<Signal\>\"", "->", "persistentSignal"}], ",", 
            RowBox[{"\"\<Activity\>\"", "->", 
             RowBox[{"persistentSignal", "^", "2"}]}], ",", 
            RowBox[{"\"\<PeakImpulse\>\"", "->", "peakImpulse"}], ",", 
            RowBox[{"\"\<PersistentActivity\>\"", "->", 
             "persistentActivity"}], ",", 
            
            RowBox[{"\"\<ConditionalScale\>\"", "->", 
             "relativeActivityScale"}], ",", 
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"severityCore", "[", "\"\<Parameters\>\"", "]"}], ",", 
               
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Persistence\>\"", "->", "persistence"}], ",", 
                 
                 RowBox[{"\"\<ActivityHalfLife\>\"", "->", 
                  "activityHalfLife"}], ",", 
                 
                 RowBox[{"\"\<StationaryMeanActivity\>\"", "->", 
                  "stationaryMeanActivity"}], ",", 
                 
                 RowBox[{"\"\<StationaryVarianceActivity\>\"", "->", 
                  "stationaryVarianceActivity"}], ",", 
                 
                 RowBox[{"\"\<VarianceNormalization\>\"", "->", 
                  "varianceNormalization"}], ",", 
                 RowBox[{"\"\<TheoreticalSignalVariance\>\"", "->", "1."}]}], 
                "|>"}]}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"persistentClusterCoefficient", "=", "0.85"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"persistentClusterCore", "=", 
     RowBox[{"AddPersistentPeakEpisodes", "[", 
      RowBox[{"peakSeverityCore", ",", 
       RowBox[{"\"\<Persistence\>\"", "->", 
        "persistentClusterCoefficient"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9959541718300257`*^9, 3.9959541759639597`*^9}, {
  3.99595432397244*^9, 
