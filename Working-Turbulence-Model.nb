Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Plots", " ", "for", " ", "non", " ", "linear", " ", "multiscale", " ", 
    "cascade"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nonlinearCascadeStatePlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"nonlinearCascadeCore", "[", "\"\<ScaleStates\>\"", "]"}], ",",
           "1000"}], "]"}], "]"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Scale 1: coarse\>\"", ",", "\"\<Scale 2\>\"", 
          ",", "\"\<Scale 3\>\"", ",", "\"\<Scale 4: fine\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Scale activity\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Nonlinear Multiscale States\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nonlinearCascadeFluxPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{
          "nonlinearCascadeCore", "[", "\"\<TransferFluxes\>\"", "]"}], ",", 
          "1000"}], "]"}], "]"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Flux 1 -> 2\>\"", ",", "\"\<Flux 2 -> 3\>\"", 
          ",", "\"\<Flux 3 -> 4\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Nonlinear transfer flux\>\""}], 
         "}"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<State-Dependent Interscale Transfer\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsColumn", "[", 
    RowBox[{"{", 
     RowBox[{"nonlinearCascadeStatePlot", ",", "nonlinearCascadeFluxPlot"}], 
     "}"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nonlinearCascadeComparisonPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{
           "linearDissipativeCascadeResult", "[", "\"\<Returns\>\"", "]"}], ",",
            "1000"}], "]"}], ",", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"nonlinearCascadeResult", "[", "\"\<Returns\>\"", "]"}], ",",
            "1000"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear dissipative cascade\>\"", 
          ",", "\"\<Nonlinear multiscale cascade\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Return\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "nonlinearCascadeComparisonPlot", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.995956842905438*^9, 3.995956863386311*^9}, 
