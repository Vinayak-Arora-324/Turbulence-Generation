Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"We", " ", "will", " ", "start", " ", "with", " ", "gaussian"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"GenerateTurbulenceCore", ",", "GaussianMarketAdapter"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "GenerateTurbulenceCore", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<RandomMethod\>\"", "->", "\"\<MersenneTwister\>\""}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GenerateTurbulenceCore", "[", 
      RowBox[{"seed_Integer", ",", 
       RowBox[{"length_Integer", "?", "Positive"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"method", ",", "signal"}], "}"}], ",", 
       RowBox[{
        RowBox[{"method", "=", 
         RowBox[{"OptionValue", "[", "\"\<RandomMethod\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"signal", "=", 
         RowBox[{"BlockRandom", "[", 
          RowBox[{
           RowBox[{"SeedRandom", "[", 
            RowBox[{"seed", ",", 
             RowBox[{"Method", "->", "method"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"0.", ",", "1."}], "]"}], ",", "length"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Model\>\"", "->", "\"\<GaussianReference\>\""}], ",", 
          RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", 
          RowBox[{"\"\<Length\>\"", "->", "length"}], ",", 
          RowBox[{"(*", 
           RowBox[{"Domain", "-", 
            RowBox[{"neutral", " ", "Gaussian", " ", "signal"}]}], "*)"}], 
          RowBox[{"\"\<Signal\>\"", "->", "signal"}], ",", 
          RowBox[{"\"\<Innovations\>\"", "->", "signal"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Derived", " ", "measurement"}], ",", 
            RowBox[{"not", " ", "a", " ", "dynamical", " ", "process"}]}], 
           "*)"}], 
          RowBox[{"\"\<Activity\>\"", "->", 
           RowBox[{"signal", "^", "2"}]}], ",", 
          RowBox[{"(*", 
           RowBox[{
           "Constant", " ", "by", " ", "definition", " ", "in", " ", "this", " ",
             "reference", " ", "model"}], "*)"}], 
          RowBox[{"\"\<ConditionalScale\>\"", "->", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1.", ",", "length"}], "]"}]}], ",", 
          RowBox[{"\"\<Parameters\>\"", "->", 
           RowBox[{"<|", 
            RowBox[{
             
             RowBox[{"\"\<Distribution\>\"", 
              "->", "\"\<NormalDistribution[0,1]\>\""}], ",", 
             RowBox[{"\"\<Independent\>\"", "->", "True"}], ",", 
             RowBox[{"\"\<RandomMethod\>\"", "->", "method"}]}], "|>"}]}]}], 
         "|>"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.995947488129724*^9, 3.995947522020405*^9}, {
  3.995948279153195*^9, 3.995948281451717*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"87890b96-1199-448b-9a75-cdfd6f86572f"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.99594755657454*^9, 3.995947563843699*^9}, 
   3.995948557762273*^9},ExpressionUUID->"7b259192-4ef2-446a-a7db-\
9f748aeb0cc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Market", " ", "adapter"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "GaussianMarketAdapter", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedLogDrift\>\"", "->", "0."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}], ",", 
       RowBox[{"\"\<PeriodsPerYear\>\"", "->", "252"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"core_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "initialPrice", ",", "annualizedLogDrift", ",", 
         "annualizedVolatility", ",", "periodsPerYear", ",", "periodDrift", ",",
          "periodScale", ",", "returns", ",", "prices"}], "}"}], ",", 
       RowBox[{
        RowBox[{"initialPrice", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<InitialPrice\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"annualizedLogDrift", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<AnnualizedLogDrift\>\"", "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"annualizedVolatility", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<AnnualizedVolatility\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"periodsPerYear", "=", 
         RowBox[{"OptionValue", "[", "\"\<PeriodsPerYear\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"periodDrift", "=", 
         RowBox[{"annualizedLogDrift", "/", "periodsPerYear"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"periodScale", "=", 
         RowBox[{"annualizedVolatility", "/", 
          RowBox[{"Sqrt", "[", "periodsPerYear", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "No", " ", "sample", " ", "centering", " ", "or", " ", "sample", " ",
           "rescaling"}], "*)"}], 
        RowBox[{"returns", "=", 
         RowBox[{"periodDrift", "+", 
          RowBox[{"periodScale", " ", 
           RowBox[{"core", "[", "\"\<Signal\>\"", "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"prices", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"Log", "[", "initialPrice", "]"}], "+", 
           RowBox[{"Accumulate", "[", "returns", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"core", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Adapter\>\"", "->", "\"\<Market\>\""}], ",", 
            RowBox[{"\"\<Returns\>\"", "->", "returns"}], ",", 
            RowBox[{"\"\<Prices\>\"", "->", "prices"}], ",", 
            RowBox[{"(*", 
             RowBox[{
             "Flat", " ", "theoretical", " ", "conditional", " ", 
              "volatility"}], "*)"}], 
            RowBox[{"\"\<Volatility\>\"", "->", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"periodScale", ",", 
               RowBox[{"Length", "[", "returns", "]"}]}], "]"}]}], ",", 
            RowBox[{"\"\<RelativeVolatility\>\"", "->", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Length", "[", "returns", "]"}]}], "]"}]}], ",", 
            RowBox[{"\"\<MarketParameters\>\"", "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<InitialPrice\>\"", "->", "initialPrice"}], ",", 
               
               RowBox[{"\"\<AnnualizedLogDrift\>\"", "->", 
                "annualizedLogDrift"}], ",", 
               
               RowBox[{"\"\<AnnualizedVolatility\>\"", "->", 
                "annualizedVolatility"}], ",", 
               RowBox[{"\"\<PeriodsPerYear\>\"", "->", "periodsPerYear"}], ",", 
               RowBox[{"\"\<PeriodScale\>\"", "->", "periodScale"}]}], 
              "|>"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.995947530119576*^9, 3.99594756586558*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"333cdbde-26d7-4e6a-8b6b-dda0b177f941"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"gaussianCore", "=", 
     RowBox[{"GenerateTurbulenceCore", "[", 
      RowBox[{"20260817", ",", "8192"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gaussianResult", "=", 
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"gaussianCore", ",", 
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Now", " ", "adding", " ", "a", " ", "higher", " ", "number", " ", "of", " ",
      "peaks", " ", "to", " ", "the", " ", "original", " ", "distribution"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "AddIndependentPeakFrequency", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AddIndependentPeakFrequency", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<PeakProbability\>\"", "->", "0.02"}], ",", 
       RowBox[{"\"\<PeakAmplification\>\"", "->", "3."}], ",", 
       RowBox[{"\"\<EventSeed\>\"", "->", "20260818"}], ",", 
       RowBox[{"\"\<RandomMethod\>\"", "->", "\"\<MersenneTwister\>\""}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AddIndependentPeakFrequency", "[", 
      RowBox[{"baseCore_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "peakProbability", ",", "peakAmplification", ",", "eventSeed", ",", 
         "randomMethod", ",", "length", ",", "peakIndicator", ",", 
         "varianceNormalization", ",", "activityMultiplier", ",", 
         "peakSignal"}], "}"}], ",", 
       RowBox[{
        RowBox[{"peakProbability", "=", 
         RowBox[{"OptionValue", "[", "\"\<PeakProbability\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peakAmplification", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<PeakAmplification\>\"", "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"eventSeed", "=", 
         RowBox[{"OptionValue", "[", "\"\<EventSeed\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"randomMethod", "=", 
         RowBox[{"OptionValue", "[", "\"\<RandomMethod\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"length", "=", 
         RowBox[{"baseCore", "[", "\"\<Length\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peakIndicator", "=", 
         RowBox[{"BlockRandom", "[", 
          RowBox[{
           RowBox[{"SeedRandom", "[", 
            RowBox[{"eventSeed", ",", 
             RowBox[{"Method", "->", "randomMethod"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{
             RowBox[{"BernoulliDistribution", "[", "peakProbability", "]"}], ",",
              "length"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"E", "[", 
           RowBox[{"activityMultiplier", "^", "2"}], "]"}], "=", 
          RowBox[{
          "1.", " ", "This", " ", "preserves", " ", "the", " ", "theoretical",
            " ", "unconditional", " ", "variance", " ", "without", " ", 
           "centering", " ", "or", " ", "normalizing", " ", "the", " ", 
           "generated", " ", 
           RowBox[{"sample", "."}]}]}], "*)"}], 
        RowBox[{"varianceNormalization", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1.", "-", "peakProbability"}], ")"}], "+", 
           RowBox[{"peakProbability", " ", 
            RowBox[{"peakAmplification", "^", "2"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"activityMultiplier", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"peakAmplification", "-", "1."}], ")"}], " ", 
             "peakIndicator"}]}], ")"}], "/", "varianceNormalization"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"peakSignal", "=", 
         RowBox[{"activityMultiplier", " ", 
          RowBox[{"baseCore", "[", "\"\<Signal\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"baseCore", ",", 
          RowBox[{"<|", 
           RowBox[{
            
            RowBox[{"\"\<Model\>\"", 
             "->", "\"\<OneDimensionalTurbulence\>\""}], ",", 
            
            RowBox[{"\"\<Stage\>\"", 
             "->", "\"\<IndependentPeakFrequency\>\""}], ",", 
            RowBox[{"\"\<Version\>\"", "->", "\"\<0.2\>\""}], ",", 
            RowBox[{"\"\<ParentStage\>\"", "->", "\"\<GaussianBase\>\""}], ",", 
            RowBox[{"\"\<GaussianSource\>\"", "->", 
             RowBox[{"baseCore", "[", "\"\<Signal\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Signal\>\"", "->", "peakSignal"}], ",", 
            RowBox[{"\"\<Activity\>\"", "->", 
             RowBox[{"peakSignal", "^", "2"}]}], ",", 
            RowBox[{"\"\<PeakIndicator\>\"", "->", "peakIndicator"}], ",", 
            RowBox[{"\"\<ConditionalScale\>\"", "->", "activityMultiplier"}], 
            ",", 
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"baseCore", "[", "\"\<Parameters\>\"", "]"}], ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<PeakProbability\>\"", "->", "peakProbability"}],
                  ",", 
                 
                 RowBox[{"\"\<PeakAmplification\>\"", "->", 
                  "peakAmplification"}], ",", 
                 RowBox[{"\"\<EventSeed\>\"", "->", "eventSeed"}], ",", 
                 
                 RowBox[{"\"\<VarianceNormalization\>\"", "->", 
                  "varianceNormalization"}], ",", 
                 RowBox[{"\"\<TheoreticalSignalVariance\>\"", "->", "1."}]}], 
                "|>"}]}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "New", " ", "Stage", " ", "using", " ", "separate", " ", "variables"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakFrequencyProbability", "=", "0.02"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakFrequencyAmplification", "=", "3."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakFrequencyEventSeed", "=", "20260818"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakFrequencyCore", "=", 
     RowBox[{"AddIndependentPeakFrequency", "[", 
      RowBox[{"gaussianCore", ",", 
       RowBox[{"\"\<PeakProbability\>\"", "->", "peakFrequencyProbability"}], 
       ",", 
       RowBox[{"\"\<PeakAmplification\>\"", "->", 
        "peakFrequencyAmplification"}], ",", 
       RowBox[{"\"\<EventSeed\>\"", "->", "peakFrequencyEventSeed"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{
