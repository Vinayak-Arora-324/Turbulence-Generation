Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Market", " ", "adapter", " ", "for", " ", "the", " ", "linear", " ", 
    "dissipative", " ", "cascade"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"linearDissipativeCascadeMarketBase", "=", 
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"linearDissipativeCascadeCore", ",", 
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"linearDissipativePeriodScale", "=", 
     RowBox[{
      RowBox[{
      "linearDissipativeCascadeMarketBase", "[", "\"\<MarketParameters\>\"", 
       "]"}], "[", "\"\<PeriodScale\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"linearDissipativeCascadeResult", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"linearDissipativeCascadeMarketBase", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Volatility\>\"", "->", 
          RowBox[{"linearDissipativePeriodScale", "*", 
           RowBox[{
           "linearDissipativeCascadeCore", "[", "\"\<ConditionalScale\>\"", 
            "]"}]}]}], ",", 
         RowBox[{"\"\<RelativeVolatility\>\"", "->", 
          RowBox[{
          "linearDissipativeCascadeCore", "[", "\"\<ConditionalScale\>\"", 
           "]"}]}]}], "|>"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9959548449992523`*^9, 3.9959548686001472`*^9}, 
   3.995955254156555*^9, {3.9959554233022118`*^9, 3.995955427519109*^9}, {
   3.995955577671103*^9, 3.9959555842822943`*^9}, 3.995955652744391*^9, {
   3.995955778902865*^9, 3.9959557832802362`*^9}, {3.995957939561365*^9, 
   3.995957942538843*^9}},
 CellLabel->
  "In[233]:=",ExpressionUUID->"d88fc850-9691-4610-9dda-f2af69d326a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Visualisation", " ", "for", " ", "linear", " ", "dissipative", " ", 
    "cascades"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"linearDissipativeScalePlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{
          "linearDissipativeCascadeCore", "[", "\"\<ScaleStates\>\"", "]"}], ",",
           "1000"}], "]"}], "]"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Scale 1: coarse\>\"", ",", "\"\<Scale 2\>\"", 
          ",", "\"\<Scale 3\>\"", ",", "\"\<Scale 4: fine\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Scale activity\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Driven Linear Dissipative Multiscale Cascade\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "linearDissipativeScalePlot", "\[IndentingNewLine]"}]}]], "Input",
