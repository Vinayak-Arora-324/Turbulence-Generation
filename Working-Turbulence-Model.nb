Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Construction", " ", "Summary", " ", "so", " ", "far"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"peakFrequencyConstructionSummary", "=", 
