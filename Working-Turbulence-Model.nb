Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Normalized", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"linearDisplayReturns", "=", 
     RowBox[{
      RowBox[{"linearDissipativeCascadeResult", "[", "\"\<Returns\>\"", "]"}],
       "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{
         "linearDissipativeCascadeResult", "[", "\"\<Returns\>\"", "]"}], "^",
          "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nonlinearDisplayReturns", "=", 
     RowBox[{
      RowBox[{"nonlinearCascadeResult", "[", "\"\<Returns\>\"", "]"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{"nonlinearCascadeResult", "[", "\"\<Returns\>\"", "]"}], "^",
          "2"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nonlinearCascadeShapeComparisonPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"linearDisplayReturns", ",", "1000"}], "]"}], ",", 
         RowBox[{"Take", "[", 
          RowBox[{"nonlinearDisplayReturns", ",", "1000"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear dissipative cascade\>\"", 
          ",", "\"\<Nonlinear multiscale cascade\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Display-normalized return\>\""}], 
         "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Shape Comparison Only \[LongDash] Model Outputs \
Unchanged\>\""}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "nonlinearCascadeShapeComparisonPlot"}]}]], "Input",
