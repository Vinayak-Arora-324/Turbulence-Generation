   RowBox[{
    RowBox[{"peakSeverityComparisonPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"peakFrequencyResult", "[", "\"\<Returns\>\"", "]"}], ",", 
           "1000"}], "]"}], ",", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"peakSeverityResult", "[", "\"\<Returns\>\"", "]"}], ",", 
           "1000"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Fixed peak severity\>\"", 
          ",", "\"\<Distributed peak severity\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Return\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\n", 
   "peakSeverityComparisonPlot"}]}]], "Input",
