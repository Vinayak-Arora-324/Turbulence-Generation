       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Return\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"persistentClusterActivityPlot", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"peakSeverityCore", "[", "\"\<ConditionalScale\>\"", "]"}],
            ",", "1000"}], "]"}], ",", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{
           "persistentClusterCore", "[", "\"\<ConditionalScale\>\"", "]"}], ",",
            "1000"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<One-period activity\>\"", 
          ",", "\"\<Persistent activity\>\""}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<Relative activity\>\""}], "}"}]}], 
       ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsColumn", "[", 
