Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Now", " ", "adding", " ", "non", " ", "linear", " ", "multiscale", " ", 
    "cascade"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "AddDrivenNonlinearMultiscaleCascade", ",", "nonlinearCascadeCore", ",", 
      "nonlinearCascadeMarketBase", ",", "nonlinearCascadeResult", ",", 
      "nonlinearCascadeStatePlot", ",", "nonlinearCascadeFluxPlot", ",", 
      "nonlinearCascadeComparisonPlot"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "AddDrivenNonlinearMultiscaleCascade", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<MaximumTransferFractions\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.25", ",", "0.40", ",", "0.55"}], "}"}]}], ",", 
       RowBox[{"\"\<TransferThresholds\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.35", ",", "0.14", ",", "0.06"}], "}"}]}], ",", 
       RowBox[{"\"\<DissipationRates\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", "0.03", ",", "0.08", ",", "0.45"}], "}"}]}], ",", 
       RowBox[{"\"\<ObservationWeights\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.10", ",", "0.15", ",", "0.25", ",", "0.50"}], "}"}]}], ",", 
       RowBox[{"\"\<FineDissipationWeight\>\"", "->", "2."}], ",", 
       RowBox[{"\"\<ActivityReference\>\"", "->", "0.15"}], ",", 
       RowBox[{"\"\<ActivityCoupling\>\"", "->", "3."}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AddDrivenNonlinearMultiscaleCascade", "[", 
      RowBox[{"linearCore_Association", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "maximumTransferFractions", ",", "transferThresholds", ",", 
         "dissipationRates", ",", "observationWeights", ",", 
         "fineDissipationWeight", ",", "activityReference", ",", 
         "activityCoupling", ",", "numberOfScales", ",", "coarseForcing", ",",
          "gaussianSource", ",", "initialState", ",", "nonlinearFlux", ",", 
         "cascadeStep", ",", "statePath", ",", "scaleStates", ",", 
         "transferFluxes", ",", "dissipationFluxes", ",", 
         "fineScaleDissipation", ",", "weightedScaleEnergy", ",", 
         "cascadeActivity", ",", "boundedCascadeActivity", ",", 
         "relativeActivityScale", ",", "nonlinearSignal", ",", 
         "baseParameters"}], "}"}], ",", 
       RowBox[{
        RowBox[{"maximumTransferFractions", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<MaximumTransferFractions\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"transferThresholds", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<TransferThresholds\>\"", "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"dissipationRates", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<DissipationRates\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"observationWeights", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<ObservationWeights\>\"", "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"fineDissipationWeight", "=", 
         RowBox[{"N", "@", 
          RowBox[{
          "OptionValue", "[", "\"\<FineDissipationWeight\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"activityReference", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<ActivityReference\>\"", "]"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"activityCoupling", "=", 
         RowBox[{"N", "@", 
          RowBox[{"OptionValue", "[", "\"\<ActivityCoupling\>\"", "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"numberOfScales", "=", 
         RowBox[{"Length", "[", "dissipationRates", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "maximumTransferFractions", "]"}], "!=", 
            RowBox[{"numberOfScales", "-", "1"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "transferThresholds", "]"}], "!=", 
            RowBox[{"numberOfScales", "-", "1"}]}], "||", 
           RowBox[{
            RowBox[{"Length", "[", "observationWeights", "]"}], "!=", 
            "numberOfScales"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidCascadeDimensions\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Transfer fractions and thresholds must have one \
fewer element than the number of scales.\>\""}], "|>"}]}], "]"}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"transferThresholds", ",", 
             RowBox[{
              RowBox[{"#", ">", "0."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidTransferThreshold\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Every transfer threshold must be positive.\>\""}], 
              "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{"maximumTransferFractions", ",", "dissipationRates"}], 
              "]"}], ",", 
             RowBox[{
              RowBox[{"#", ">=", "0."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<NegativeRate\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Transfer fractions and dissipation rates must be \
non-negative.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"MapThread", "[", 
              RowBox[{"Plus", ",", 
               RowBox[{"{", 
                RowBox[{"dissipationRates", ",", 
                 RowBox[{"Append", "[", 
                  RowBox[{"maximumTransferFractions", ",", "0."}], "]"}]}], 
                "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", "<=", "1."}], "&"}]}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidActivityBudget\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Maximum transfer plus dissipation cannot exceed one \
at any scale.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", "observationWeights", "]"}], "<=", "0."}], "||", 
           RowBox[{"activityReference", "<=", "0."}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Failure", "[", 
            RowBox[{"\"\<InvalidObservationMap\>\"", ",", 
             RowBox[{"<|", 
              
              RowBox[{"\"\<Message\>\"", 
               "->", "\"\<Observation weights and ActivityReference must be \
positive.\>\""}], "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"observationWeights", "=", 
         RowBox[{"observationWeights", "/", 
          RowBox[{"Total", "[", "observationWeights", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coarseForcing", "=", 
         RowBox[{"linearCore", "[", "\"\<PeakImpulse\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gaussianSource", "=", 
         RowBox[{"linearCore", "[", "\"\<GaussianSource\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"initialState", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", "numberOfScales"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"At", " ", "low", " ", 
           RowBox[{"energy", ":", 
            RowBox[{
            "flux", " ", "is", " ", "approximately", " ", "proportional", " ",
              "to", " ", 
             RowBox[{"E", "^", 
              RowBox[{"(", 
               RowBox[{"3", "/", "2"}], ")"}]}], " ", "At", " ", "high", " ", 
             "energy"}], ":", 
            RowBox[{
            "flux", " ", "approaches", " ", "maximumFraction", " ", "E", " ", 
             "Therefore"}]}]}], ",", 
          RowBox[{
          "outgoing", " ", "flux", " ", "is", " ", "nonlinear", " ", "but", " ", 
           RowBox[{"bounded", "."}]}]}], "*)"}], 
        RowBox[{"nonlinearFlux", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"state", ",", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"energy", ",", "maximumFraction", ",", "threshold"}], 
                "}"}], ",", 
               RowBox[{"maximumFraction", " ", "energy", "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"energy", "/", "threshold"}], "]"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"1.", "+", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"energy", "/", "threshold"}], "]"}]}], ")"}]}], 
                 ")"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Most", "[", "state", "]"}], ",", 
               "maximumTransferFractions", ",", "transferThresholds"}], 
              "}"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cascadeStep", "=", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"state", ",", "forcing"}], "}"}], ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"outgoingFlux", ",", "dissipation", ",", "nextState"}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{"outgoingFlux", "=", 
               RowBox[{"nonlinearFlux", "[", "state", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"dissipation", "=", 
               RowBox[{"dissipationRates", " ", "state"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"nextState", "=", 
               RowBox[{"state", "-", "dissipation", "-", 
                RowBox[{"Append", "[", 
                 RowBox[{"outgoingFlux", ",", "0."}], "]"}], "+", 
                RowBox[{"Prepend", "[", 
                 RowBox[{"outgoingFlux", ",", "0."}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"nextState", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+=", "forcing"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"0.", ",", "#"}], "]"}], "&"}], ",", "nextState"}], 
               "]"}]}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"statePath", "=", 
         RowBox[{"FoldList", "[", 
          RowBox[{"cascadeStep", ",", "initialState", ",", "coarseForcing"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"scaleStates", "=", 
         RowBox[{"Rest", "[", "statePath", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"transferFluxes", "=", 
         RowBox[{"nonlinearFlux", "/@", "scaleStates"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dissipationFluxes", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dissipationRates", " ", "#"}], "&"}], ",", 
           "scaleStates"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fineScaleDissipation", "=", 
         RowBox[{"dissipationFluxes", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"weightedScaleEnergy", "=", 
         RowBox[{"scaleStates", ".", "observationWeights"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cascadeActivity", "=", 
         RowBox[{"weightedScaleEnergy", "+", 
          RowBox[{"fineDissipationWeight", " ", "fineScaleDissipation"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"boundedCascadeActivity", "=", 
         RowBox[{"cascadeActivity", "/", 
          RowBox[{"(", 
           RowBox[{"activityReference", "+", "cascadeActivity"}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"relativeActivityScale", "=", 
         RowBox[{"1.", "+", 
          RowBox[{"activityCoupling", " ", "boundedCascadeActivity"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"nonlinearSignal", "=", 
         RowBox[{"relativeActivityScale", " ", "gaussianSource"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"baseParameters", "=", 
         RowBox[{"KeyDrop", "[", 
          RowBox[{
           RowBox[{"linearCore", "[", "\"\<Parameters\>\"", "]"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<TransferRates\>\"", 
             ",", "\"\<StationaryMeanScaleState\>\"", 
             ",", "\"\<StationaryMeanCascadeActivity\>\"", 
             ",", "\"\<StationaryVarianceCascadeActivity\>\"", 
             ",", "\"\<VarianceNormalization\>\"", 
             ",", "\"\<TheoreticalSignalVariance\>\""}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"KeyDrop", "[", 
           RowBox[{"linearCore", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<ScaleStates\>\"", ",", "\"\<TransferFluxes\>\"", 
              ",", "\"\<DissipationFluxes\>\"", ",", "\"\<CascadeActivity\>\"",
               ",", "\"\<ConditionalScale\>\"", ",", "\"\<Signal\>\"", 
              ",", "\"\<Activity\>\""}], "}"}]}], "]"}], ",", 
          RowBox[{"<|", 
           RowBox[{
            
            RowBox[{"\"\<Model\>\"", 
             "->", "\"\<OneDimensionalTurbulence\>\""}], ",", 
            
            RowBox[{"\"\<Stage\>\"", 
             "->", "\"\<DrivenNonlinearMultiscaleCascade\>\""}], ",", 
            RowBox[{"\"\<Version\>\"", "->", "\"\<0.6\>\""}], ",", 
            
            RowBox[{"\"\<ParentStage\>\"", 
             "->", "\"\<DrivenLinearDissipativeCascade\>\""}], ",", 
            RowBox[{"\"\<ForcingType\>\"", "->", "\"\<ExternallyDriven\>\""}],
             ",", 
            
            RowBox[{"\"\<TransferType\>\"", 
             "->", "\"\<BoundedNonlinearE3Over2\>\""}], ",", 
            
            RowBox[{"\"\<DissipationType\>\"", 
             "->", "\"\<LinearScaleDependent\>\""}], ",", 
            RowBox[{"\"\<Signal\>\"", "->", "nonlinearSignal"}], ",", 
            RowBox[{"\"\<Activity\>\"", "->", 
             RowBox[{"nonlinearSignal", "^", "2"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
             "Same", " ", "interface", " ", "as", " ", "the", " ", "linear", " ",
               "cascade"}], "*)"}], 
            RowBox[{"\"\<ScaleStates\>\"", "->", "scaleStates"}], ",", 
            RowBox[{"\"\<TransferFluxes\>\"", "->", "transferFluxes"}], ",", 
            RowBox[{"\"\<DissipationFluxes\>\"", "->", "dissipationFluxes"}], 
            ",", 
            RowBox[{"\"\<CascadeActivity\>\"", "->", "cascadeActivity"}], ",", 
            
            RowBox[{"\"\<ConditionalScale\>\"", "->", 
             "relativeActivityScale"}], ",", 
            RowBox[{"(*", 
             RowBox[{"Additional", " ", "nonlinear", " ", "diagnostics"}], 
             "*)"}], 
            
            RowBox[{"\"\<FineScaleDissipation\>\"", "->", 
             "fineScaleDissipation"}], ",", 
            
            RowBox[{"\"\<BoundedCascadeActivity\>\"", "->", 
             "boundedCascadeActivity"}], ",", 
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{"baseParameters", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<NumberOfScales\>\"", "->", "numberOfScales"}], ",", 
                 RowBox[{"\"\<MaximumTransferFractions\>\"", "->", 
                  "maximumTransferFractions"}], ",", 
                 
                 RowBox[{"\"\<TransferThresholds\>\"", "->", 
                  "transferThresholds"}], ",", 
                 
                 RowBox[{"\"\<DissipationRates\>\"", "->", 
                  "dissipationRates"}], ",", 
                 
                 RowBox[{"\"\<ObservationWeights\>\"", "->", 
                  "observationWeights"}], ",", 
                 
                 RowBox[{"\"\<FineDissipationWeight\>\"", "->", 
                  "fineDissipationWeight"}], ",", 
                 
                 RowBox[{"\"\<ActivityReference\>\"", "->", 
                  "activityReference"}], ",", 
                 
                 RowBox[{"\"\<ActivityCoupling\>\"", "->", 
                  "activityCoupling"}], ",", 
                 
                 RowBox[{"\"\<SignalVarianceNormalization\>\"", 
                  "->", "\"\<None\>\""}]}], "|>"}]}], "]"}]}]}], "|>"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nonlinearCascadeCore", "=", 
     RowBox[{"AddDrivenNonlinearMultiscaleCascade", "[", 
      RowBox[{"linearDissipativeCascadeCore", ",", 
       RowBox[{"\"\<MaximumTransferFractions\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.25", ",", "0.40", ",", "0.55"}], "}"}]}], ",", 
       RowBox[{"\"\<TransferThresholds\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.35", ",", "0.14", ",", "0.06"}], "}"}]}], ",", 
       RowBox[{"\"\<DissipationRates\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", "0.03", ",", "0.08", ",", "0.45"}], "}"}]}], ",", 
       RowBox[{"\"\<ObservationWeights\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.10", ",", "0.15", ",", "0.25", ",", "0.50"}], "}"}]}], ",", 
       RowBox[{"\"\<FineDissipationWeight\>\"", "->", "2."}], ",", 
       RowBox[{"\"\<ActivityReference\>\"", "->", "0.15"}], ",", 
       RowBox[{"\"\<ActivityCoupling\>\"", "->", "3."}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Head", "[", "nonlinearCascadeCore", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.995956557577519*^9, 3.9959566375207577`*^9}, 
