Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Market", " ", "adapter", " ", "for", " ", "a", " ", "higher", " ", 
    "number", " ", "of", " ", "peaks"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"peakFrequencyMarketBase", "=", 
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"peakFrequencyCore", ",", 
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"peakFrequencyRelativeScale", "=", 
     RowBox[{"peakFrequencyCore", "[", "\"\<ConditionalScale\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakFrequencyPeriodScale", "=", 
     RowBox[{
      RowBox[{
      "peakFrequencyMarketBase", "[", "\"\<MarketParameters\>\"", "]"}], 
      "[", "\"\<PeriodScale\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakFrequencyResult", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"peakFrequencyMarketBase", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Volatility\>\"", "->", 
          RowBox[{
          "peakFrequencyPeriodScale", " ", "peakFrequencyRelativeScale"}]}], ",", 
         RowBox[{"\"\<RelativeVolatility\>\"", "->", 
          "peakFrequencyRelativeScale"}]}], "|>"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
