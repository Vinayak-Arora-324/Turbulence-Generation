Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Market", " ", "adapter"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"persistentClusterMarketBase", "=", 
     RowBox[{"GaussianMarketAdapter", "[", 
      RowBox[{"persistentClusterCore", ",", 
       RowBox[{"\"\<InitialPrice\>\"", "->", "100."}], ",", 
       RowBox[{"\"\<AnnualizedVolatility\>\"", "->", "0.20"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"persistentClusterRelativeScale", "=", 
     RowBox[{
     "persistentClusterCore", "[", "\"\<ConditionalScale\>\"", "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"persistentClusterPeriodScale", "=", 
     RowBox[{
      RowBox[{
      "persistentClusterMarketBase", "[", "\"\<MarketParameters\>\"", "]"}], 
      "[", "\"\<PeriodScale\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"persistentClusterResult", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"persistentClusterMarketBase", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Volatility\>\"", "->", 
          RowBox[{
          "persistentClusterPeriodScale", "*", 
           "persistentClusterRelativeScale"}]}], ",", 
         RowBox[{"\"\<RelativeVolatility\>\"", "->", 
          "persistentClusterRelativeScale"}]}], "|>"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
