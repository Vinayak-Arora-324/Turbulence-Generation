Notebook[{
Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "How", " ", "can", " ", "seeded", " ", "deterministic", " ", "generator", " ",
    "give", " ", "rise", " ", "to", " ", "intermittent", " ", "multiscale", " ",
    "processes"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.995935813213221*^9, 3.995935820720592*^9}, {
  3.995941173092804*^9, 3.995941184028194*^9}, {3.9959412158371763`*^9, 
  3.9959412273143997`*^9}},ExpressionUUID->"78d76e76-4bf0-4a96-9387-\
c58f4f68e5e2"],

Cell[CellGroupData[{

Cell[BoxData[GridBox[{
   {
    RowBox[{
     RowBox[{
      RowBox[{"ClearAll", "[", 
       RowBox[{
       "caStep", ",", "caUniform", ",", "caGaussian", ",", "standardize", ",",
         "ar1", ",", "dyadicField", ",", "generateMarket"}], "]"}], ";"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"1.", " ", "Deterministic", " ", "Rule"}], "-", 
       RowBox[{"30", " ", "engine"}]}], "*)"}], "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"caStep", "[", 
        RowBox[{"state_List", ",", 
         RowBox[{"rule_Integer", ":", "30"}]}], "]"}], ":=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BitGet", "[", 
           RowBox[{"rule", ",", 
            RowBox[{
             RowBox[{"4", " ", "#1"}], "+", 
             RowBox[{"2", " ", "#2"}], "+", "#3"}]}], "]"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RotateRight", "[", "state", "]"}], ",", "state", ",", 
           RowBox[{"RotateLeft", "[", "state", "]"}]}], "}"}]}], "]"}]}], 
      ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"caUniform", "[", 
        RowBox[{
         RowBox[{"n_Integer", "?", "Positive"}], ",", "seed_Integer", ",", 
         RowBox[{"width_Integer", ":", "127"}], ",", 
         RowBox[{"burnIn_Integer", ":", "512"}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"state", ",", 
           RowBox[{"bits", "=", "53"}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"state", "=", 
           RowBox[{"IntegerDigits", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "seed", "]"}], "+", "1"}], ",", "2", ",", 
             "width"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"state", "=", 
             RowBox[{"caStep", "[", "state", "]"}]}], ",", 
            RowBox[{"{", "burnIn", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"state", "=", 
               RowBox[{"caStep", "[", "state", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"FromDigits", "[", 
                  RowBox[{
                   RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"RotateLeft", "[", 
                    RowBox[{"state", ",", 
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"37", " ", "t"}], "+", "seed"}], ",", "width"}], 
                    "]"}]}], "]"}], ",", "bits"}], "]"}], ",", "2"}], "]"}], "+", 
                 RowBox[{"1", "/", "2"}]}], ")"}], "/", 
               RowBox[{"2", "^", "bits"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", "n"}], "}"}]}], "]"}], "//", "N"}]}]}], 
        "]"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"caGaussian", "[", 
        RowBox[{"n_", ",", "seed_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"Sqrt", "[", "2.", "]"}], " ", 
        RowBox[{"InverseErf", "[", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"caUniform", "[", 
            RowBox[{"n", ",", "seed"}], "]"}]}], "-", "1"}], "]"}]}]}], ";"}],
      "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Temporal", " ", "and", " ", "multiscale", " ", 
       "components"}], "*)"}], 
     SubscriptBox[
      SubscriptBox["\[IndentingNewLine]", "\[Placeholder]"], 
      "\[Placeholder]"], 
     RowBox[{
      RowBox[{
       RowBox[{"standardize", "[", "x_List", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"Mean", "[", "x", "]"}]}], ")"}], "/", 
        RowBox[{"StandardDeviation", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ar1", "[", 
        RowBox[{"x_List", ",", "persistence_"}], "]"}], ":=", 
       RowBox[{"Rest", "@", 
        RowBox[{"FoldList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"persistence", " ", "#1"}], "+", 
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", "-", 
               RowBox[{"persistence", "^", "2"}]}], "]"}], " ", "#2"}]}], 
           "&"}], ",", "0.", ",", "x"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"dyadicField", "[", 
        RowBox[{"n_", ",", "scale_", ",", "seed_", ",", "persistence_"}], 
        "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "coarse", "}"}], ",", 
         RowBox[{
          RowBox[{"coarse", "=", 
           RowBox[{"caGaussian", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Ceiling", "[", 
               RowBox[{"n", "/", "scale"}], "]"}], "+", "2"}], ",", "seed"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"coarse", "=", 
           RowBox[{"standardize", "@", 
            RowBox[{"ar1", "[", 
             RowBox[{"coarse", ",", "persistence"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"standardize", "@", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"#", ",", "scale"}], "]"}], "&"}], "/@", "coarse"}], 
              "]"}], ",", "n"}], "]"}]}]}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "3.", " ", "Turbulence", " ", "core", " ", "plus", " ", "market", " ", 
       "adapter"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"generateMarket", "[", 
        RowBox[{
         RowBox[{"n_Integer", "?", "Positive"}], ",", "seed_Integer", ",", 
         RowBox[{"levels_Integer", ":", "9"}], ",", 
         RowBox[{"intermittency_", ":", "0.35"}], ",", 
         RowBox[{"persistence_", ":", "0.70"}], ",", 
         RowBox[{"annualizedVolatility_", ":", "0.20"}], ",", 
         RowBox[{"initialPrice_", ":", "100."}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "innovations", ",", "fields", ",", "logVolatility", ",", 
           "relativeVolatility", ",", "dailyVolatility", ",", "returns", ",", 
           "logPrices"}], "}"}], ",", 
         RowBox[{
          RowBox[{"innovations", "=", 
           RowBox[{"standardize", "@", 
            RowBox[{"caGaussian", "[", 
             RowBox[{"n", ",", 
              RowBox[{"seed", "+", "7919"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fields", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"dyadicField", "[", 
              RowBox[{"n", ",", 
               RowBox[{"2", "^", 
                RowBox[{"(", 
                 RowBox[{"level", "-", "1"}], ")"}]}], ",", 
               RowBox[{"seed", "+", 
                RowBox[{"104729", " ", "level"}]}], ",", "persistence"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"level", ",", "levels"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"logVolatility", "=", 
           RowBox[{"intermittency", " ", 
            RowBox[{
             RowBox[{"Total", "[", "fields", "]"}], "/", 
             RowBox[{"Sqrt", "[", "levels", "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"relativeVolatility", "=", 
           RowBox[{"Exp", "[", "logVolatility", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"relativeVolatility", "/=", 
           RowBox[{"Mean", "[", "relativeVolatility", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dailyVolatility", "=", 
           RowBox[{"annualizedVolatility", "/", 
            RowBox[{"Sqrt", "[", "252.", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"returns", "=", 
             RowBox[{"dailyVolatility", " ", 
              RowBox[{"standardize", "[", 
               RowBox[{"relativeVolatility", " ", "innovations"}], "]"}]}]}], 
            ";"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"scaleToRMS", "[", 
            RowBox[{"x_List", ",", "target_"}], "]"}], ":=", 
           RowBox[{"target", " ", 
            RowBox[{"x", "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Mean", "[", 
               RowBox[{"x", "^", "2"}], "]"}], "]"}]}]}]}], ";", "\n", 
          "       ", 
          RowBox[{"returns", "=", 
           RowBox[{"scaleToRMS", "[", 
            RowBox[{
             RowBox[{"relativeVolatility", " ", "innovations"}], ",", 
             "dailyVolatility"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"logPrices", "=", 
           RowBox[{
            RowBox[{"Log", "[", "initialPrice", "]"}], "+", 
            RowBox[{"Accumulate", "[", "returns", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Returns\>\"", "->", "returns"}], ",", 
            RowBox[{"\"\<Prices\>\"", "->", 
             RowBox[{"Exp", "[", "logPrices", "]"}]}], ",", 
            RowBox[{"\"\<LogPrices\>\"", "->", "logPrices"}], ",", 
            RowBox[{"\"\<Volatility\>\"", "->", 
             RowBox[{"dailyVolatility", " ", "relativeVolatility"}]}], ",", 
            RowBox[{"\"\<Innovation\>\"", "->", "innovations"}], ",", 
            RowBox[{"\"\<LogVolatility\>\"", "->", "logVolatility"}], ",", 
            RowBox[{"\"\<ScaleFields\>\"", "->", "fields"}]}], "|>"}]}]}], 
        "]"}]}], ";"}], "\[IndentingNewLine]"}]},
   {"\[Placeholder]"}
  }]], "Input",
 CellChangeTimes->{{3.9959409908413343`*^9, 3.995941049807716*^9}, {
